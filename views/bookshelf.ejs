<!-- ═══════════════════════════════════════════
   BOOKSHELF — Stardew Valley Item Inventory
   ═══════════════════════════════════════════ -->

<div class="sd-inventory">

  <!-- 仓库标题栏 -->
  <header class="sd-inv-header">
    <div class="sd-inv-title">
      <span class="sd-inv-icon">📦</span>
      <span>物品仓库</span>
    </div>
    <div class="sd-inv-stats">
      <div class="sd-inv-stat">
        <span class="sd-inv-stat-num"><%= books.length %></span>
        <span class="sd-inv-stat-label">总物品</span>
      </div>
      <div class="sd-inv-stat">
        <span class="sd-inv-stat-num sd-green"><%= summary.finishedCount %></span>
        <span class="sd-inv-stat-label">已收集</span>
      </div>
      <div class="sd-inv-stat">
        <span class="sd-inv-stat-num sd-blue"><%= books.filter(function(b){return !b.finished && b.progress > 0}).length %></span>
        <span class="sd-inv-stat-label">使用中</span>
      </div>
      <div class="sd-inv-stat">
        <span class="sd-inv-stat-num sd-gray"><%= allCategories.length %></span>
        <span class="sd-inv-stat-label">种类</span>
      </div>
    </div>
  </header>

  <!-- 筛选菜单 -->
  <div class="sd-inv-menu">
    <div class="sd-inv-tabs">
      <a href="/bookshelf?filter=all&sort=<%= sortBy %>"
         class="sd-inv-tab <%= filter === 'all' && !category ? 'active' : '' %>">全部</a>
      <a href="/bookshelf?filter=reading&sort=<%= sortBy %>"
         class="sd-inv-tab <%= filter === 'reading' ? 'active' : '' %>">使用中</a>
      <a href="/bookshelf?filter=finished&sort=<%= sortBy %>"
         class="sd-inv-tab <%= filter === 'finished' ? 'active' : '' %>">已收集</a>
      <a href="/bookshelf?filter=want_to_read&sort=<%= sortBy %>"
         class="sd-inv-tab <%= filter === 'want_to_read' ? 'active' : '' %>">未获得</a>
    </div>
    <div class="sd-inv-sort">
      <select class="sd-inv-select"
              onchange="window.location.href='/bookshelf?filter=<%= filter %>&sort='+this.value<% if (category) { %>+'&category=<%= encodeURIComponent(category) %>'<% } %>">
        <option value="readtime" <%= sortBy === 'readtime' ? 'selected' : '' %>>按价值</option>
        <option value="recent"   <%= sortBy === 'recent' ? 'selected' : '' %>>最近使用</option>
        <option value="title"    <%= sortBy === 'title' ? 'selected' : '' %>>名称</option>
        <option value="author"   <%= sortBy === 'author' ? 'selected' : '' %>>来源</option>
      </select>
    </div>
  </div>

  <!-- 分类标签 -->
  <% if (allCategories.length > 0) { %>
  <div class="sd-inv-cats">
    <% allCategories.forEach(function(c) { %>
    <a href="/bookshelf?category=<%= encodeURIComponent(c) %>&filter=<%= filter %>"
       class="sd-inv-cat <%= category === c ? 'active' : '' %>"><%= c %></a>
    <% }); %>
    <a href="/bookshelf?filter=<%= filter %>"
       class="sd-inv-cat <%= !category ? 'active' : '' %>">全部</a>
  </div>
  <% } %>

  <!-- 物品网格 -->
  <% if (books.length > 0) { %>
  <div class="sd-item-grid">
    <% books.forEach(function(b, i) {
      var isReading = !b.finished && b.progress > 0;
      var isFinished = !!b.finished;
      var isWish = !b.finished && !isReading && !!b.want_to_read;
      var rarity = isFinished ? 'rare' : (isReading ? 'common' : 'uncommon');
      var statusLabel = isReading ? '使用中' : (isFinished ? '已收集' : (isWish ? '未获得' : ''));
    %>
    <div class="sd-item-card rarity-<%= rarity %> <%= isWish ? 'locked' : '' %>"
         style="animation-delay: <%= Math.min(i * 30, 600) %>ms">
      <!-- 物品图标区 -->
      <a class="sd-item-icon-wrap" href="/book/<%= b.id %>">
        <% if (b.cover) { %>
          <img src="<%= b.cover %>" alt="" loading="lazy" class="sd-item-img"
               onerror="this.style.display='none';this.parentElement.innerHTML='<span class=sd-item-fallback>📖</span>'">
        <% } else { %>
          <span class="sd-item-fallback">📖</span>
        <% } %>
        <!-- 状态标记 -->
        <% if (isFinished) { %>
          <div class="sd-item-badge sd-badge-green">✓</div>
        <% } else if (isReading) { %>
          <div class="sd-item-badge sd-badge-blue">▶</div>
        <% } else if (isWish) { %>
          <div class="sd-item-badge sd-badge-gray">?</div>
        <% } %>
        <!-- 想读按钮 -->
        <button class="sd-item-wish <%= b.want_to_read ? 'active' : '' %>"
                onclick="event.preventDefault();event.stopPropagation();toggleWish(this,'<%= b.id %>')"
                title="<%= b.want_to_read ? '取消想读' : '标记想读' %>">
          <%= b.want_to_read ? '♥' : '♡' %>
        </button>
      </a>

      <!-- 使用中进度条 -->
      <% if (isReading) { %>
      <div class="sd-item-progress">
        <div class="sd-item-progress-fill" style="width:<%= Math.min(b.progress || 0, 100) %>%"></div>
      </div>
      <% } %>

      <!-- 物品信息 -->
      <div class="sd-item-info">
        <div class="sd-item-name"><a href="/book/<%= b.id %>"><%= b.title %></a></div>
        <div class="sd-item-source"><%= b.author || '佚名' %></div>
        <div class="sd-item-foot">
          <% if (b.readTimeSec && b.readTimeSec > 0) { %>
          <span class="sd-item-value">⏱ <%= helpers.formatTime(b.readTimeSec) %></span>
          <% } %>
          <% if (statusLabel) { %>
          <span class="sd-item-status status-<%= isReading ? 'blue' : (isFinished ? 'green' : 'gray') %>"><%= statusLabel %></span>
          <% } %>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <div class="sd-inv-empty">
    <div class="sd-inv-empty-icon">📭</div>
    <p>仓库里没有符合条件的物品</p>
  </div>
  <% } %>

</div>
