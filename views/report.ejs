<section class="report-page">
  <!-- Hero — 年度总览 -->
  <div class="rp-hero">
    <div class="rp-hero-bg" aria-hidden="true"></div>
    <div class="rp-hero-inner">
      <div class="rp-hero-year"><%= year %></div>
      <div class="rp-hero-divider" aria-hidden="true"></div>
      <div class="rp-hero-bignum"><%= report.totalHours %><span class="rp-hero-unit">h</span></div>
      <div class="rp-hero-label">总阅读时长</div>
      <div class="rp-hero-meta">
        <% if (report.yoyChange !== null) { %>
        <span class="rp-hero-yoy <%= report.yoyChange > 0 ? 'up' : 'down' %>">
          <%= report.yoyChange > 0 ? '↑' : '↓' %><%= Math.abs(report.yoyChange) %>% vs <%= year-1 %>
        </span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Stats Grid — 阅读数据面板 -->
  <div class="rp-stats-grid">
    <div class="rp-stat-card">
      <div class="rp-stat-icon">✓</div>
      <div class="rp-stat-num"><%= report.finished %></div>
      <div class="rp-stat-label">已读完</div>
    </div>
    <div class="rp-stat-card">
      <div class="rp-stat-icon">📚</div>
      <div class="rp-stat-num"><%= report.totalBooks %></div>
      <div class="rp-stat-label">加入书架</div>
    </div>
    <div class="rp-stat-card">
      <div class="rp-stat-icon">☀</div>
      <div class="rp-stat-num"><%= report.readDays %></div>
      <div class="rp-stat-label">阅读天数</div>
    </div>
    <div class="rp-stat-card">
      <div class="rp-stat-icon">✎</div>
      <div class="rp-stat-num"><%= report.totalHighlights %></div>
      <div class="rp-stat-label">划线笔记</div>
    </div>
    <div class="rp-stat-card">
      <div class="rp-stat-icon">💭</div>
      <div class="rp-stat-num"><%= report.totalReviews %></div>
      <div class="rp-stat-label">想法评论</div>
    </div>
  </div>

  <!-- Top Book — 年度之书 -->
  <% if (report.topBook) { %>
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">年度之书</h2>
      <span class="rp-section-tag">最用心</span>
    </div>
    <div class="rp-topbook">
      <% if (report.topBook.cover) { %>
      <div class="rp-topbook-cover-wrap">
        <img src="<%= report.topBook.cover %>" alt="" class="rp-topbook-cover" loading="lazy">
        <div class="rp-topbook-shadow" aria-hidden="true"></div>
      </div>
      <% } %>
      <div class="rp-topbook-body">
        <h3 class="rp-topbook-title"><%= report.topBook.title %></h3>
        <p class="rp-topbook-author"><%= report.topBook.author %></p>
        <div class="rp-topbook-stats">
          <span class="rp-topbook-notes"><%= report.topBook.totalNotes %> 条笔记</span>
          <% if (report.topBook.category) { %>
          <span class="rp-topbook-cat"><%= report.topBook.category %></span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Longest — 最耗时 -->
  <% if (report.longest) { %>
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">最耗时之书</h2>
      <span class="rp-section-tag">沉浸最久</span>
    </div>
    <div class="rp-longest">
      <div class="rp-longest-info">
        <span class="rp-longest-title"><%= report.longest.title %></span>
        <span class="rp-longest-author"><%= report.longest.author %></span>
      </div>
      <div class="rp-longest-time"><%= helpers.formatTime(report.longest.read_time) %></div>
    </div>
  </div>
  <% } %>

  <!-- Monthly Rhythm — 阅读节奏 -->
  <% if (report.trends.length > 0) { %>
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">阅读节奏</h2>
      <span class="rp-section-tag">月度分布</span>
    </div>
    <div class="rp-rhythm">
      <% const maxSec = Math.max(...report.trends.map(t => t.totalSec), 1); %>
      <% report.trends.forEach(t => { %>
      <div class="rp-rhythm-row">
        <div class="rp-rhythm-label"><%= t.month %>月</div>
        <div class="rp-rhythm-track">
          <div class="rp-rhythm-fill" style="width:<%= Math.max(2, t.totalSec / maxSec * 100) %>%">
            <div class="rp-rhythm-glow"></div>
          </div>
        </div>
        <div class="rp-rhythm-val"><%= t.hours %>h</div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Categories — 阅读版图 -->
  <% if (report.categories.length > 0) { %>
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">阅读版图</h2>
      <span class="rp-section-tag">类型分布</span>
    </div>
    <div class="rp-cats">
      <% const maxCat = Math.max(...report.categories.map(c => c.cnt)); %>
      <% report.categories.forEach((c, i) => { %>
      <div class="rp-cat-row">
        <div class="rp-cat-name"><%= c.category || '未分类' %></div>
        <div class="rp-cat-track">
          <div class="rp-cat-fill" style="width:<%= Math.max(3, c.cnt / maxCat * 100) %>%"></div>
        </div>
        <div class="rp-cat-count"><%= c.cnt %>册</div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Footer note -->
  <div class="rp-footnote">
    <p>数据来自微信读书 · 静心阅读，自有回响</p>
    <div class="rp-nav-row">
      <a href="/report?year=<%= year - 1 %>" class="rp-year-link">&larr; <%= year - 1 %> 年报</a>
      <% if (year < new Date().getFullYear()) { %>
      <a href="/report?year=<%= year + 1 %>" class="rp-year-link"><%= year + 1 %> 年报 &rarr;</a>
      <% } %>
    </div>
  </div>
</section>
