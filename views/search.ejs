<section class="page-section">
  <div class="search-hero">
    <form class="search-form" action="/search" method="get">
      <input type="text" name="q" class="search-input" value="<%= query %>"
             placeholder="搜索书名、作者、划线、想法..." autofocus autocomplete="off">
      <button type="submit" class="search-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>
  </div>

  <% if (results) { %>
    <div class="search-stats"><%= query %> — <%= totalResults %> 条结果</div>

    <% if (results.books.length > 0) { %>
    <div class="search-section">
      <h3 class="search-section-title">书籍 (<%= results.books.length %>)</h3>
      <div class="search-books">
        <% results.books.forEach(b => { %>
          <a href="/book/<%= b.id %>" class="search-book-card">
            <div class="search-book-cover">
              <% if (b.cover) { %><img src="<%= b.cover %>" alt="<%= b.title %>" loading="lazy"><% } %>
            </div>
            <div class="search-book-info">
              <div class="search-book-title"><%= b.title %></div>
              <div class="search-book-author"><%= b.author %></div>
              <% if (b.category) { %><span class="search-book-cat"><%= b.category %></span><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (results.highlights.length > 0) { %>
    <div class="search-section">
      <h3 class="search-section-title">划线 (<%= results.highlights.length %>)</h3>
      <% results.highlights.forEach(h => { %>
        <a href="/book/<%= h.book_id %>" class="search-result-card highlight-result">
          <div class="search-result-header">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent2)" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            <span class="search-result-type">划线</span>
            <span class="search-result-from">《<%= h.book_title %>》</span>
            <% if (h.chapter) { %><span class="search-result-chapter"><%= h.chapter %></span><% } %>
          </div>
          <div class="search-result-text"><%= h.text %></div>
        </a>
      <% }) %>
    </div>
    <% } %>

    <% if (results.reviews.length > 0) { %>
    <div class="search-section">
      <h3 class="search-section-title">想法 (<%= results.reviews.length %>)</h3>
      <% results.reviews.forEach(r => { %>
        <a href="/book/<%= r.book_id %>" class="search-result-card review-result">
          <div class="search-result-header">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent-bright)" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span class="search-result-type">想法</span>
            <span class="search-result-from">《<%= r.book_title %>》</span>
            <% if (r.chapter) { %><span class="search-result-chapter"><%= r.chapter %></span><% } %>
          </div>
          <div class="search-result-text"><%= r.text %></div>
        </a>
      <% }) %>
    </div>
    <% } %>

    <% if (results.books.length === 0 && results.highlights.length === 0 && results.reviews.length === 0) { %>
      <div class="search-empty">没有找到「<%= query %>」相关的结果</div>
    <% } %>
  <% } else { %>
    <div class="search-hint">输入关键词搜索你的阅读足迹</div>
  <% } %>
</section>
