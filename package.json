{
  "name": "huangs-reading-room",
  "version": "1.0.0",
  "description": "个人读书网站 — 基于微信读书数据",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "deploy": "git pull origin main && npm install && npx tsc && (pm2 delete reading-room || true) && pm2 start ecosystem.config.json && pm2 save"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.1",
    "ejs": "^3.1.10",
    "express": "^4.22.2",
    "express-ejs-layouts": "^2.5.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  }
}
