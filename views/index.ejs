<!-- ═══════════════════════════════════════════
   HOME — Literary Magazine Dashboard
   杂志式精选首页：只保留有“当下感”的内容，统计详情全部下沉到读书纪
   ═══════════════════════════════════════════ -->

<div class="container-wide">
  <div class="hero hero--magazine">
    <p class="hero-lede">READING ROOM · 阅读书房</p>
    <h1 class="hero-title">有之以为利，无之以为用。</h1>
    <p class="hero-sub"><%= summary.totalBooks %> 册藏书 · <%= summary.finishedCount %> 册已读完 · <%= summary.totalNoteCount.toLocaleString() %> 条笔记</p>
  </div>
</div>

<!-- ═══ 快速状态 ═══ -->
<div class="container-wide">
  <div class="quick-stats">
    <div class="qstat-card">
      <div class="qstat-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="1"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
      <div class="qstat-num"><%= hpStats.monthDays %></div>
      <div class="qstat-label">本月阅读天数</div>
    </div>
    <div class="qstat-card">
      <div class="qstat-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
      <div class="qstat-num"><%= hpStats.readingCount %></div>
      <div class="qstat-label">在读</div>
    </div>
    <div class="qstat-card">
      <div class="qstat-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div>
      <div class="qstat-num"><%= hpStats.newNotes %></div>
      <div class="qstat-label">近七日笔记</div>
    </div>
    <div class="qstat-card">
      <div class="qstat-icon"><%- hpStats.todayRead ? '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>' : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2c.9 2.5 4.2 4.6 4.2 8.2a4.2 4.2 0 0 1-8.4 0c0-1.9.9-3.5 2.1-4.7.1 1.5.9 2.6 1.6 3.2-.6-2.3.5-4.9.5-6.7z"/></svg>' %></div>
      <% if (hpStats.currentStreak > 0) { %>
      <div class="qstat-num"><%= hpStats.currentStreak %>天</div>
      <div class="qstat-label">连续阅读</div>
      <% } else { %>
      <div class="qstat-num qstat-warn">今天还没读</div>
      <div class="qstat-label">最长连读 <%= hpStats.maxStreak %> 天</div>
      <% } %>
    </div>
  </div>
  <% if (!hpStats.todayRead && hpStats.currentStreak > 0) { %>
  <div class="streak-alert"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-2px;margin-right:6px"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>连续 <%= hpStats.currentStreak %> 天在读书，今天还没打开书</div>
  <% } else if (!hpStats.todayRead && hpStats.currentStreak === 0) { %>
  <div class="streak-alert"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-2px;margin-right:6px"><path d="M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"/><rect x="3" y="7" width="18" height="14" rx="1"/><path d="M3 12h18M3 16h18"/></svg>今天记得打开一本书</div>
  <% } %>
</div>

<!-- ═══ I. 正在阅读 ═══ -->
<% if (currentlyReading && currentlyReading.length > 0) { %>
<div class="container-wide">
  <hr class="section-rule">
  <div class="section-kicker">I. 正在阅读</div>

  <div class="reading-now-list">
    <% currentlyReading.forEach(function(b) { %>
    <a class="reading-item" href="/book/<%= b.id %>">
      <div class="reading-item-cover">
        <% if (b.cover) { %><img src="<%= b.cover %>" alt="" loading="lazy" onerror="this.style.display='none'"><% } else { %><span class="cover-fb">书</span><% } %>
      </div>
      <div class="reading-item-info">
        <div class="reading-item-title"><%= b.title %></div>
        <div class="reading-item-author"><%= b.author %></div>
        <% if (b.progress && b.progress > 0) { %><div class="reading-item-progress"><%= b.progress %>% completed</div><% } %>
      </div>
    </a>
    <% }); %>
  </div>
</div>
<% } %>

<!-- ═══ III. 年度之书 ═══ -->
<% var homeTopBooks = (annual.topBooks && annual.topBooks.length) ? annual.topBooks : ((overall.topBooks && overall.topBooks.length) ? overall.topBooks : []); %>
<% if (homeTopBooks.length > 0) { %>
<div class="container-wide">
  <hr class="section-rule">
  <div class="hm-section-head">
    <div class="section-kicker">II. 年度之书</div>
    <a class="section-more" href="/bookshelf">全部藏书 →</a>
  </div>

  <div class="book-card-grid">
    <% homeTopBooks.slice(0, 4).forEach(function(b) { %>
    <div class="book-card" onclick="window.location.href='/bookshelf'">
      <div class="book-card-cover">
        <% if (b.cover) { %><img src="<%= b.cover %>" alt="" loading="lazy" onerror="this.style.display='none'"><% } else { %><span class="cover-fb">书</span><% } %>
      </div>
      <div class="book-card-body">
        <div class="book-card-title"><%= b.title %></div>
        <div class="book-card-author"><%= b.author %></div>
        <% if (b.readTime) { %><div class="book-card-duration"><%= helpers.formatTime(b.readTime) %></div><% } %>
        <% if (b.tags && b.tags.length > 0) { %>
          <span class="book-card-badge"><%= b.tags[0] %></span>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div>
</div>
<% } %>

<!-- ═══ IV. 书房一瞥 ═══ -->
<div class="container-wide">
  <hr class="section-rule">
  <div class="section-kicker">III. 书房一瞥</div>

  <div class="library-index">
    <a class="lib-entry" href="/bookshelf">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"/><rect x="3" y="7" width="18" height="14" rx="1"/><path d="M3 12h18M3 16h18"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">万卷楼</span>
        <span class="lib-entry-desc"><%= summary.totalBooks %> 册藏书 · 分类筛选</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/notebooks">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">札记</span>
        <span class="lib-entry-desc"><%= summary.totalNoteCount.toLocaleString() %> 条笔记与想法</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/stats">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 20v-6M12 20V9M18 20V4"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">读书纪</span>
        <span class="lib-entry-desc">全年数据 · 深度统计</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/timeline">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">阅读年轮</span>
        <span class="lib-entry-desc">读完的每一本书，都长出一圈年轮</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/authors">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M3 21v-2a6 6 0 0 1 12 0v2"/><circle cx="17.5" cy="8.5" r="2.8"/><path d="M21 21v-1.5a4.5 4.5 0 0 0-3.2-4.3"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">文友录</span>
        <span class="lib-entry-desc">与作者的相遇</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/booklists">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">书单卷</span>
        <span class="lib-entry-desc">自己整理的主题书单</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/badges">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M8.7 11.8 7.2 21l4.8-2.8L16.8 21l-1.5-9.2"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">功勋录</span>
        <span class="lib-entry-desc">阅读历程的勋章</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/covers">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1"/><circle cx="8.5" cy="9" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">书衣墙</span>
        <span class="lib-entry-desc"><%= summary.totalBooks %> 册封面画廊</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
    <a class="lib-entry" href="/report">
      <span class="lib-entry-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg></span>
      <span class="lib-entry-body">
        <span class="lib-entry-name">年度报告</span>
        <span class="lib-entry-desc">一年的阅读叙事</span>
      </span>
      <span class="lib-entry-arrow">→</span>
    </a>
  </div>
</div>
