<!-- ═══════════════════════════════════════════════════════
   BOOK DETAIL — Redesigned
   Curated reading experience with editorial depth.
   ═══════════════════════════════════════════════════════ -->
<div class="bd-container" data-book-title="<%= book.title.replace(/"/g, '&quot;') %>" data-book-author="<%= (book.author || '').replace(/"/g, '&quot;') %>">

  <!-- Breadcrumb -->
  <nav class="bd-breadcrumb">
    <a href="/" class="bd-breadcrumb-home">阅读书房</a>
    <span class="bd-breadcrumb-sep">/</span>
    <a href="/bookshelf" class="bd-breadcrumb-link">书架</a>
    <span class="bd-breadcrumb-sep">/</span>
    <span class="bd-breadcrumb-current"><%= book.title %></span>
  </nav>

  <!-- ═══ Hero: Cover + Info ═══ -->
  <section class="bd-hero">
    <!-- Decorative background character -->
    <div class="bd-hero-decor" aria-hidden="true">读</div>

    <div class="bd-hero-cover">
      <% if (book.cover) { %>
        <img src="<%= book.cover %>" alt="<%= book.title %> 封面" onerror="this.style.display='none';this.parentElement.querySelector('.bd-hero-cover-fallback').style.display='flex'">
      <% } %>
      <div class="bd-hero-cover-fallback" style="display:<%= book.cover ? 'none' : 'flex' %>">&#128218;</div>
      <!-- Progress ring (reading books only) -->
      <% if (!book.finished && book.progress > 0) { %>
      <div class="bd-cover-progress">
        <svg viewBox="0 0 36 36" class="bd-cover-progress-ring">
          <path class="bd-cover-progress-bg"
            d="M18 2.0845
              a 15.9155 15.9155 0 0 1 0 31.831
              a 15.9155 15.9155 0 0 1 0 -31.831"
            fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
          <path class="bd-cover-progress-fill"
            d="M18 2.0845
              a 15.9155 15.9155 0 0 1 0 31.831
              a 15.9155 15.9155 0 0 1 0 -31.831"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-dasharray="<%= book.progress %>, 100"
            stroke-linecap="round"/>
        </svg>
        <span class="bd-cover-progress-text"><%= book.progress %>%</span>
      </div>
      <% } %>
    </div>

    <div class="bd-hero-body">
      <!-- Status + Category -->
      <div class="bd-hero-meta">
        <% if (book.category) { %>
        <span class="bd-hero-category"><%= book.category %></span>
        <% } %>
        <span class="bd-hero-status <%= book.finished ? 'bd-hero-status--finished' : 'bd-hero-status--reading' %>">
          <%= book.finished ? '已读完' : '在读' %>
        </span>
      </div>

      <!-- Title -->
      <h1 class="bd-hero-title"><%= book.title %></h1>
      <p class="bd-hero-author"><%= book.author || '佚名' %></p>

      <!-- Stats Cards -->
      <div class="bd-stats">
        <% if (readTimeSec > 0) { %>
        <div class="bd-stat-card">
          <div class="bd-stat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="bd-stat-body">
            <span class="bd-stat-value"><%= helpers.formatTime(readTimeSec) %></span>
            <span class="bd-stat-label">阅读时长</span>
          </div>
        </div>
        <% } %>
        <% if (book.progress > 0) { %>
        <div class="bd-stat-card">
          <div class="bd-stat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="bd-stat-body">
            <span class="bd-stat-value"><%= book.progress %>%</span>
            <span class="bd-stat-label">阅读进度</span>
          </div>
        </div>
        <% } %>
        <% if (book.notebook) { %>
          <% if (book.notebook.noteCount > 0) { %>
          <div class="bd-stat-card">
            <div class="bd-stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div class="bd-stat-body">
              <span class="bd-stat-value"><%= book.notebook.noteCount %></span>
              <span class="bd-stat-label">划线</span>
            </div>
          </div>
          <% } %>
          <% if (book.notebook.reviewCount > 0) { %>
          <div class="bd-stat-card">
            <div class="bd-stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="bd-stat-body">
              <span class="bd-stat-value"><%= book.notebook.reviewCount %></span>
              <span class="bd-stat-label">想法</span>
            </div>
          </div>
          <% } %>
          <% if (book.notebook.bookmarkCount > 0) { %>
          <div class="bd-stat-card">
            <div class="bd-stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="bd-stat-body">
              <span class="bd-stat-value"><%= book.notebook.bookmarkCount %></span>
              <span class="bd-stat-label">书签</span>
            </div>
          </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ═══ Divider ═══ -->
  <div class="bd-divider">
    <span class="bd-divider-ornament">❧</span>
  </div>

  <!-- ═══ Book Intro ═══ -->
  <% if (intro) { %>
  <section class="bd-intro">
    <div class="bd-intro-card">
      <span class="bd-intro-quote-mark" aria-hidden="true">"</span>
      <div class="bd-intro-body" id="book-intro-body">
        <p><%= intro %></p>
      </div>
      <% if (intro.length > 200) { %>
      <button class="bd-intro-toggle" id="intro-toggle" onclick="
        var b=document.getElementById('book-intro-body');
        var t=document.getElementById('intro-toggle');
        b.classList.toggle('bd-intro-body--expanded');
        t.textContent = b.classList.contains('bd-intro-body--expanded') ? '收起简介' : '展开全文';
      ">展开全文</button>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- ═══ Reading Footprint + Chapter Activity ═══ -->
  <% if ((monthlyBars && monthlyBars.length > 0) || chapterActivity.length > 0) { %>
  <section class="bd-insight-grid">
    <!-- Reading Footprint -->
    <div class="bd-insight-card">
      <h3 class="bd-insight-title">阅读足迹</h3>
      <% if (monthlyBars && monthlyBars.length > 0) { %>
      <div class="bd-monthly-bars">
        <% monthlyBars.forEach(function(m) { %>
        <div class="bd-monthly-row">
          <span class="bd-monthly-label"><%= m.label %></span>
          <div class="bd-monthly-track">
            <div class="bd-monthly-fill" style="width: <%= Math.round((m.estimatedSec / maxMonthlySec) * 100) %>%;">
              <span class="bd-monthly-time"><%= m.timeLabel %></span>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="bd-monthly-empty">
        <% if (readTimeSec > 0) { %>
          <p class="bd-monthly-empty-total">累计 <%= helpers.formatTime(readTimeSec) %></p>
          <p class="bd-monthly-empty-hint">按月分布将在下次同步后显示</p>
        <% } else { %>
          <p class="bd-monthly-empty-hint">暂无月度阅读记录</p>
        <% } %>
      </div>
      <% } %>
    </div>

    <!-- Chapter Activity -->
    <% if (chapterActivity.length > 0) { %>
    <div class="bd-insight-card">
      <h3 class="bd-insight-title">章节热度</h3>
      <div class="bd-chapter-bars">
        <% chapterActivity.forEach(function(c) { %>
        <div class="bd-chapter-row">
          <span class="bd-chapter-label" title="<%= c.chapter %>"><%= c.chapter.length > 14 ? c.chapter.slice(0,14) + '…' : c.chapter %></span>
          <div class="bd-chapter-track">
            <div class="bd-chapter-fill" style="width: <%= Math.round((c.total / maxChapterTotal) * 100) %>%;">
              <span class="bd-chapter-count"><%= c.total %> 条</span>
            </div>
          </div>
          <span class="bd-chapter-detail">
            <% if (c.highlights > 0) { %><span class="bd-chap-dot bd-chap-dot--hl"></span><%= c.highlights %><% } %>
            <% if (c.reviews > 0) { %><span class="bd-chap-dot bd-chap-dot--rv"></span><%= c.reviews %><% } %>
          </span>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </section>
  <% } %>

  <!-- ═══ Highlights & Reviews ═══ -->
  <% if (highlights.length > 0 || reviews.length > 0) { %>
  <section class="bd-notes-section">

    <!-- Section Header: Ornamental -->
    <header class="bd-notes-header">
      <div class="bd-notes-header-deco" aria-hidden="true"></div>
      <h2 class="bd-notes-header-title">阅读笔记</h2>
      <p class="bd-notes-header-sub">摘录与随想</p>
      <div class="bd-notes-header-line"></div>
    </header>

    <!-- Two Columns -->
    <div class="bd-notes-grid">
      <!-- Highlights Column -->
      <div class="bd-notes-col bd-notes-col--hl">
        <div class="bd-col-head">
          <div class="bd-col-head-left">
            <span class="bd-col-head-icon" aria-hidden="true">❝</span>
            <h3 class="bd-col-head-title">划线摘录</h3>
            <span class="bd-col-head-count"><%= highlights.length %></span>
          </div>
          <% if (highlights.length > 4) { %>
          <button class="bd-shuffle-btn" data-section="highlights" data-book="<%= book.id %>" title="随机换一批">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </button>
          <% } %>
        </div>
        <% if (highlights.length > 0) { %>
        <div class="bd-highlights" id="book-highlights">
          <% highlights.forEach(function(h, idx) { %>
          <article class="bd-hl-card">
            <span class="bd-hl-num" aria-hidden="true"><%= String(idx + 1).padStart(2, '0') %></span>
            <blockquote class="bd-hl-body">
              <p class="bd-hl-text"><%= h.text %></p>
            </blockquote>
            <% if (h.chapter) { %>
            <footer class="bd-hl-foot">
              <span class="bd-hl-chap">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                <%= h.chapter %>
              </span>
              <button class="bd-share-btn highlight-share-btn" data-text="<%= h.text.replace(/"/g, '&quot;') %>" data-chapter="<%= (h.chapter || '').replace(/"/g, '&quot;') %>" title="生成分享图" aria-label="生成分享图">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </footer>
            <% } %>
          </article>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bd-empty-block">暂无摘录</div>
        <% } %>
      </div>

      <!-- Reviews Column -->
      <div class="bd-notes-col bd-notes-col--rv">
        <div class="bd-col-head">
          <div class="bd-col-head-left">
            <span class="bd-col-head-icon" aria-hidden="true">✦</span>
            <h3 class="bd-col-head-title">我的想法</h3>
            <span class="bd-col-head-count"><%= reviews.length %></span>
          </div>
          <% if (reviews.length > 4) { %>
          <button class="bd-shuffle-btn" data-section="reviews" data-book="<%= book.id %>" title="随机换一批">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </button>
          <% } %>
        </div>
        <% if (reviews.length > 0) { %>
        <div class="bd-reviews" id="book-reviews">
          <% reviews.forEach(function(r, idx) { %>
          <article class="bd-rv-card">
            <span class="bd-rv-num" aria-hidden="true"><%= String(idx + 1).padStart(2, '0') %></span>
            <% if (r.abstract) { %>
            <aside class="bd-rv-quote-wrap">
              <span class="bd-rv-qmark" aria-hidden="true">\201C</span>
              <p class="bd-rv-quote"><%= r.abstract %></p>
            </aside>
            <% } %>
            <div class="bd-rv-body">
              <p class="bd-rv-text"><%= r.content %></p>
            </div>
            <footer class="bd-rv-foot">
              <span class="bd-rv-meta">
                <% if (r.star > 0) { %><span class="bd-rv-stars" title="<%= r.star %> 星"><% for (var s=0; s<r.star; s++) { %>\u2605<% } %></span><% } %>
                <% if (r.chapter) { %><span class="bd-rv-chap"><%= r.chapter %></span><% } %>
              </span>
              <button class="bd-share-btn review-share-btn" data-quote="<%= (r.abstract || '').replace(/"/g, '&quot;') %>" data-review="<%= r.content.replace(/"/g, '&quot;') %>" data-chapter="<%= (r.chapter || '').replace(/"/g, '&quot;') %>" title="生成分享图" aria-label="生成分享图">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </footer>
          </article>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bd-empty-block">暂无想法</div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ═══ Notes by Chapter ═══ -->
  <% if (notesByChapter && notesByChapter.length > 0) { %>
  <div class="bd-divider"></div>
  <section class="bd-toc">
    <h3 class="bd-insight-title">全书笔记分布</h3>
    <div class="bd-toc-list">
      <% notesByChapter.forEach(function(c, i) { %>
      <div class="bd-toc-item">
        <span class="bd-toc-index"><%= String(i + 1).padStart(2, '0') %></span>
        <span class="bd-toc-name"><%= c.chapter %></span>
        <span class="bd-toc-count"><%= c.count %> 条笔记</span>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Back to top -->
  <div class="bd-footer-nav">
    <a href="/bookshelf" class="bd-footer-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      返回书架
    </a>
  </div>

</div>

