<%- contentFor('title') %><%= title %>

<div class="bl-container">

  <!-- Breadcrumb -->
  <nav class="bl-breadcrumb"><a href="/booklists">← 书单推荐</a></nav>

  <!-- Header -->
  <header class="bl-detail-head">
    <h1 class="bl-detail-title"><%= list.name %></h1>
    <% if (list.description) { %>
    <p class="bl-detail-desc"><%= list.description %></p>
    <% } %>
    <p class="bl-detail-meta"><%= list.items.length %> 本书</p>
  </header>

  <!-- Add book -->
  <div class="bl-add-bar">
    <select class="bl-add-select" id="bl-add-select">
      <option value="">选择要添加的书…</option>
    </select>
    <button class="bl-btn-primary" id="bl-add-btn">添加</button>
  </div>

  <!-- Book list -->
  <% if (list.items.length === 0) { %>
  <div class="bl-empty">
    <div class="bl-empty-icon">📚</div>
    <p>这个书单还没有书</p>
    <p class="bl-empty-sub">从上方选择书籍添加</p>
  </div>
  <% } else { %>

  <ol class="bl-items" id="bl-items">
    <% list.items.forEach(function(item, idx) { %>
    <li class="bl-item" data-book-id="<%= item.book_id %>">
      <span class="bl-item-num"><%= idx + 1 %></span>
      <a href="/book/<%= item.book_id %>" class="bl-item-cover" tabindex="-1">
        <% if (item.cover) { %>
        <img src="<%= item.cover %>" alt="<%= item.title %>" loading="lazy" />
        <% } else { %>
        <div class="bl-cover-fallback">📖</div>
        <% } %>
      </a>
      <div class="bl-item-body">
        <h2 class="bl-item-title"><a href="/book/<%= item.book_id %>"><%= item.title %></a></h2>
        <p class="bl-item-author"><%= item.author || '' %></p>
        <% if (item.note) { %>
        <p class="bl-item-note" data-note="<%= item.note %>"><%= item.note %></p>
        <% } else { %>
        <p class="bl-item-note bl-item-note--empty" data-note="">点击添加推荐语…</p>
        <% } %>
      </div>
      <button class="bl-icon-btn bl-remove-btn" data-book-id="<%= item.book_id %>" title="从书单移除">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 4h10M6 4V2h4v2M5 4l1 9h4l1-9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </button>
    </li>
    <% }); %>
  </ol>

  <% } %>

</div>

<script>
(function(){
  var listId = <%= list.id %>;
  var allBooks = <%- allBooks %>;

  // Populate select
  var sel = document.getElementById('bl-add-select');
  var existingIds = new Set(Array.from(document.querySelectorAll('.bl-item')).map(function(el){ return el.dataset.bookId; }));
  allBooks.forEach(function(b){
    if (existingIds.has(b.id)) return;
    var opt = document.createElement('option');
    opt.value = b.id;
    opt.textContent = b.title + (b.author ? ' — ' + b.author : '');
    sel.appendChild(opt);
  });

  // Add book
  document.getElementById('bl-add-btn').addEventListener('click', function(){
    var bookId = sel.value;
    if (!bookId) return;
    fetch('/api/booklists/' + listId + '/books', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ bookId: bookId })
    }).then(function(){ location.reload(); });
  });

  // Remove book
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.bl-remove-btn');
    if (!btn) return;
    if (!confirm('从书单移除这本书？')) return;
    fetch('/api/booklists/' + listId + '/books/' + btn.dataset.bookId, { method: 'DELETE' })
      .then(function(){ location.reload(); });
  });

  // Inline note edit
  document.addEventListener('click', function(e){
    var note = e.target.closest('.bl-item-note');
    if (!note || note.querySelector('textarea')) return;
    var old = note.dataset.note || '';
    var ta = document.createElement('textarea');
    ta.className = 'bl-note-edit';
    ta.value = old;
    ta.rows = 2;
    ta.placeholder = '推荐语…';
    note.innerHTML = '';
    note.appendChild(ta);
    ta.focus();

    function save() {
      var val = ta.value.trim();
      var bookId = note.closest('.bl-item').dataset.bookId;
      fetch('/api/booklists/' + listId + '/books/' + bookId, {
        method: 'PUT', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ note: val })
      }).then(function(){
        note.dataset.note = val;
        note.textContent = val || '点击添加推荐语…';
        note.classList.toggle('bl-item-note--empty', !val);
      });
    }

    ta.addEventListener('blur', save);
    ta.addEventListener('keydown', function(ev){ if (ev.key === 'Enter' && !ev.shiftKey){ ev.preventDefault(); ta.blur(); } });
  });
})();
</script>
