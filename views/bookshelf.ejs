<!-- ═══════════════════════════════════════════
   BOOKSHELF — Editorial Book Catalog
   ═══════════════════════════════════════════ -->

<div class="container-bookshelf">
  <div class="catalog-header">
    <h1>书架</h1>
    <div class="catalog-count"><%= books.length %> 册藏书 · <%= summary.finishedCount %> 册已读完</div>
  </div>

  <!-- Status filter — pill toggle group -->
  <div class="catalog-filters">
    <div class="filter-pill-group">
      <a href="/bookshelf?filter=all" class="filter-pill <%= filter === 'all' && !category ? 'active' : '' %>">全部</a>
      <a href="/bookshelf?filter=reading" class="filter-pill <%= filter === 'reading' ? 'active' : '' %>">在读</a>
      <a href="/bookshelf?filter=finished" class="filter-pill <%= filter === 'finished' ? 'active' : '' %>">已读完</a>
    </div>
    <% if (category) { %>
    <span class="filter-breadcrumb">
      <span class="filter-breadcrumb-label"><%= category %></span>
      <a href="/bookshelf?filter=<%= filter %>" class="filter-breadcrumb-clear" title="清除分类">×</a>
    </span>
    <% } %>
  </div>

  <!-- Category chips -->
  <% if (allCategories.length > 0) { %>
  <div class="category-chips">
    <% allCategories.forEach(function(c) { %>
    <a href="/bookshelf?category=<%= encodeURIComponent(c) %>&filter=<%= filter %>"
       class="category-chip <%= category === c ? 'active' : '' %>">
      <%= c %>
    </a>
    <% }); %>
    <a href="/bookshelf?filter=<%= filter %>" class="category-chip category-chip-all <%= !category ? 'active' : '' %>">全部分类</a>
  </div>
  <% } %>

  <!-- Book Card Grid -->
  <% if (books.length > 0) { %>
  <div class="book-card-grid">
    <% books.forEach(function(b) { %>
    <div class="book-card" onclick="openBookModal('<%= b.id %>')">
      <div class="book-card-cover">
        <% if (b.cover) { %><img src="<%= b.cover %>" alt="" loading="lazy" onerror="this.style.display='none';this.parentElement.innerHTML='📖'"><% } else { %>📖<% } %>
      </div>
      <div class="book-card-body">
        <div class="book-card-title"><%= b.title %></div>
        <div class="book-card-author"><%= b.author || '佚名' %></div>
        <% if (b.readTimeSec) { %><div class="book-card-duration"><%= helpers.formatTime(b.readTimeSec) %></div><% } %>
        <% if (b.finished) { %><span class="book-card-badge">已读完</span><% } %>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-state-icon">—</div>
    <p class="empty-state-text">没有符合条件的藏书</p>
  </div>
  <% } %>
</div>
