<!-- ═══════════════════════════════════════════════════════
   BOOK DETAIL — Redesigned
   Curated reading experience with editorial depth.
   ═══════════════════════════════════════════════════════ -->
<div class="bd-container" data-book-title="<%= book.title.replace(/"/g, '&quot;') %>" data-book-author="<%= (book.author || '').replace(/"/g, '&quot;') %>">

  <!-- Breadcrumb -->
  <nav class="bd-breadcrumb">
    <a href="/" class="bd-breadcrumb-home">阅读书房</a>
    <span class="bd-breadcrumb-sep">/</span>
    <a href="/bookshelf" class="bd-breadcrumb-link">书架</a>
    <span class="bd-breadcrumb-sep">/</span>
    <span class="bd-breadcrumb-current"><%= book.title %></span>
  </nav>

  <!-- ═══ Hero: Cover + Info ═══ -->
  <section class="bd-hero">
    <!-- Decorative background character -->
    <div class="bd-hero-decor" aria-hidden="true">读</div>

    <div class="bd-hero-cover">
      <% if (book.cover) { %>
        <img src="<%= book.cover %>" alt="<%= book.title %> 封面" onerror="this.style.display='none';this.parentElement.querySelector('.bd-hero-cover-fallback').style.display='flex'">
      <% } %>
      <div class="bd-hero-cover-fallback" style="display:<%= book.cover ? 'none' : 'flex' %>">&#128218;</div>
      <!-- Progress ring (reading books only) -->
      <% if (!book.finished && book.progress > 0) { %>
      <div class="bd-cover-progress">
        <svg viewBox="0 0 36 36" class="bd-cover-progress-ring">
          <path class="bd-cover-progress-bg"
            d="M18 2.0845
              a 15.9155 15.9155 0 0 1 0 31.831
              a 15.9155 15.9155 0 0 1 0 -31.831"
            fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
          <path class="bd-cover-progress-fill"
            d="M18 2.0845
              a 15.9155 15.9155 0 0 1 0 31.831
              a 15.9155 15.9155 0 0 1 0 -31.831"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-dasharray="<%= book.progress %>, 100"
            stroke-linecap="round"/>
        </svg>
        <span class="bd-cover-progress-text"><%= book.progress %>%</span>
      </div>
      <% } %>
    </div>

    <div class="bd-hero-body">
      <!-- Status + Category -->
      <div class="bd-hero-meta">
        <% if (book.category) { %>
        <span class="bd-hero-category"><%= book.category %></span>
        <% } %>
        <span class="bd-hero-status <%= book.finished ? 'bd-hero-status--finished' : 'bd-hero-status--reading' %>">
          <%= book.finished ? '已读完' : '在读' %>
        </span>
      </div>

      <!-- Title -->
      <h1 class="bd-hero-title"><%= book.title %></h1>
      <p class="bd-hero-author"><%= book.author || '佚名' %></p>

      <!-- Rating -->
      <div class="bd-hero-rating" id="star-rating">
        <% for (var s = 1; s <= 5; s++) { %>
        <button class="bd-star <%= s <= userRating ? 'bd-star--active' : '' %>" onclick="rateBook('<%= book.id %>',<%= s %>)" title="<%= s %>星" aria-label="评分 <%= s %> 星">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="<%= s <= userRating ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </button>
        <% } %>
      </div>

      <!-- Stats Cards -->
      <div class="bd-stats">
        <% if (readTimeSec > 0) { %>
        <div class="bd-stat-card">
          <div class="bd-stat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="bd-stat-body">
            <span class="bd-stat-value"><%= helpers.formatTime(readTimeSec) %></span>
            <span class="bd-stat-label">阅读时长</span>
          </div>
        </div>
        <% } %>
        <% if (book.progress > 0) { %>
        <div class="bd-stat-card">
          <div class="bd-stat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="bd-stat-body">
            <span class="bd-stat-value"><%= book.progress %>%</span>
            <span class="bd-stat-label">阅读进度</span>
          </div>
        </div>
        <% } %>
        <% if (book.notebook) { %>
          <% if (book.notebook.noteCount > 0) { %>
          <div class="bd-stat-card">
            <div class="bd-stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div class="bd-stat-body">
              <span class="bd-stat-value"><%= book.notebook.noteCount %></span>
              <span class="bd-stat-label">划线</span>
            </div>
          </div>
          <% } %>
          <% if (book.notebook.reviewCount > 0) { %>
          <div class="bd-stat-card">
            <div class="bd-stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="bd-stat-body">
              <span class="bd-stat-value"><%= book.notebook.reviewCount %></span>
              <span class="bd-stat-label">想法</span>
            </div>
          </div>
          <% } %>
          <% if (book.notebook.bookmarkCount > 0) { %>
          <div class="bd-stat-card">
            <div class="bd-stat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="bd-stat-body">
              <span class="bd-stat-value"><%= book.notebook.bookmarkCount %></span>
              <span class="bd-stat-label">书签</span>
            </div>
          </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ═══ Divider ═══ -->
  <div class="bd-divider">
    <span class="bd-divider-ornament">❧</span>
  </div>

  <!-- ═══ Book Intro ═══ -->
  <% if (intro) { %>
  <section class="bd-intro">
    <div class="bd-intro-card">
      <span class="bd-intro-quote-mark" aria-hidden="true">"</span>
      <div class="bd-intro-body" id="book-intro-body">
        <p><%= intro %></p>
      </div>
      <% if (intro.length > 200) { %>
      <button class="bd-intro-toggle" id="intro-toggle" onclick="
        var b=document.getElementById('book-intro-body');
        var t=document.getElementById('intro-toggle');
        b.classList.toggle('bd-intro-body--expanded');
        t.textContent = b.classList.contains('bd-intro-body--expanded') ? '收起简介' : '展开全文';
      ">展开全文</button>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- ═══ Reading Footprint + Chapter Activity ═══ -->
  <% if ((monthlyBars && monthlyBars.length > 0) || chapterActivity.length > 0) { %>
  <section class="bd-insight-grid">
    <!-- Reading Footprint -->
    <div class="bd-insight-card">
      <h3 class="bd-insight-title">阅读足迹</h3>
      <% if (monthlyBars && monthlyBars.length > 0) { %>
      <div class="bd-monthly-bars">
        <% monthlyBars.forEach(function(m) { %>
        <div class="bd-monthly-row">
          <span class="bd-monthly-label"><%= m.label %></span>
          <div class="bd-monthly-track">
            <div class="bd-monthly-fill" style="width: <%= Math.round((m.estimatedSec / maxMonthlySec) * 100) %>%;">
              <span class="bd-monthly-time"><%= m.timeLabel %></span>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="bd-monthly-empty">
        <% if (readTimeSec > 0) { %>
          <p class="bd-monthly-empty-total">累计 <%= helpers.formatTime(readTimeSec) %></p>
          <p class="bd-monthly-empty-hint">按月分布将在下次同步后显示</p>
        <% } else { %>
          <p class="bd-monthly-empty-hint">暂无月度阅读记录</p>
        <% } %>
      </div>
      <% } %>
    </div>

    <!-- Chapter Activity -->
    <% if (chapterActivity.length > 0) { %>
    <div class="bd-insight-card">
      <h3 class="bd-insight-title">章节热度</h3>
      <div class="bd-chapter-bars">
        <% chapterActivity.forEach(function(c) { %>
        <div class="bd-chapter-row">
          <span class="bd-chapter-label" title="<%= c.chapter %>"><%= c.chapter.length > 14 ? c.chapter.slice(0,14) + '…' : c.chapter %></span>
          <div class="bd-chapter-track">
            <div class="bd-chapter-fill" style="width: <%= Math.round((c.total / maxChapterTotal) * 100) %>%;">
              <span class="bd-chapter-count"><%= c.total %> 条</span>
            </div>
          </div>
          <span class="bd-chapter-detail">
            <% if (c.highlights > 0) { %><span class="bd-chap-dot bd-chap-dot--hl"></span><%= c.highlights %><% } %>
            <% if (c.reviews > 0) { %><span class="bd-chap-dot bd-chap-dot--rv"></span><%= c.reviews %><% } %>
          </span>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </section>
  <% } %>

  <!-- ═══ Highlights & Reviews ═══ -->
  <% if (highlights.length > 0 || reviews.length > 0) { %>
  <section class="bd-notes-section">

    <!-- Section Header: Ornamental -->
    <header class="bd-notes-header">
      <div class="bd-notes-header-deco" aria-hidden="true"></div>
      <h2 class="bd-notes-header-title">阅读笔记</h2>
      <p class="bd-notes-header-sub">摘录与随想</p>
      <div class="bd-notes-header-line"></div>
    </header>

    <!-- Two Columns -->
    <div class="bd-notes-grid">
      <!-- Highlights Column -->
      <div class="bd-notes-col bd-notes-col--hl">
        <div class="bd-col-head">
          <div class="bd-col-head-left">
            <span class="bd-col-head-icon" aria-hidden="true">❝</span>
            <h3 class="bd-col-head-title">划线摘录</h3>
            <span class="bd-col-head-count"><%= highlights.length %></span>
          </div>
          <% if (highlights.length > 4) { %>
          <button class="bd-shuffle-btn" data-section="highlights" data-book="<%= book.id %>" title="随机换一批">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </button>
          <% } %>
        </div>
        <% if (highlights.length > 0) { %>
        <div class="bd-highlights" id="book-highlights">
          <% highlights.forEach(function(h, idx) { %>
          <article class="bd-hl-card">
            <span class="bd-hl-num" aria-hidden="true"><%= String(idx + 1).padStart(2, '0') %></span>
            <blockquote class="bd-hl-body">
              <p class="bd-hl-text"><%= h.text %></p>
            </blockquote>
            <% if (h.chapter) { %>
            <footer class="bd-hl-foot">
              <span class="bd-hl-chap">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                <%= h.chapter %>
              </span>
              <button class="bd-share-btn highlight-share-btn" data-text="<%= h.text.replace(/"/g, '&quot;') %>" data-chapter="<%= (h.chapter || '').replace(/"/g, '&quot;') %>" title="生成分享图" aria-label="生成分享图">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </footer>
            <% } %>
          </article>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bd-empty-block">暂无摘录</div>
        <% } %>
      </div>

      <!-- Reviews Column -->
      <div class="bd-notes-col bd-notes-col--rv">
        <div class="bd-col-head">
          <div class="bd-col-head-left">
            <span class="bd-col-head-icon" aria-hidden="true">✦</span>
            <h3 class="bd-col-head-title">我的想法</h3>
            <span class="bd-col-head-count"><%= reviews.length %></span>
          </div>
          <% if (reviews.length > 4) { %>
          <button class="bd-shuffle-btn" data-section="reviews" data-book="<%= book.id %>" title="随机换一批">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </button>
          <% } %>
        </div>
        <% if (reviews.length > 0) { %>
        <div class="bd-reviews" id="book-reviews">
          <% reviews.forEach(function(r, idx) { %>
          <article class="bd-rv-card">
            <span class="bd-rv-num" aria-hidden="true"><%= String(idx + 1).padStart(2, '0') %></span>
            <% if (r.abstract) { %>
            <aside class="bd-rv-quote-wrap">
              <span class="bd-rv-qmark" aria-hidden="true">\201C</span>
              <p class="bd-rv-quote"><%= r.abstract %></p>
            </aside>
            <% } %>
            <div class="bd-rv-body">
              <p class="bd-rv-text"><%= r.content %></p>
            </div>
            <footer class="bd-rv-foot">
              <span class="bd-rv-meta">
                <% if (r.star > 0) { %><span class="bd-rv-stars" title="<%= r.star %> 星"><% for (var s=0; s<r.star; s++) { %>\u2605<% } %></span><% } %>
                <% if (r.chapter) { %><span class="bd-rv-chap"><%= r.chapter %></span><% } %>
              </span>
              <button class="bd-share-btn review-share-btn" data-quote="<%= (r.abstract || '').replace(/"/g, '&quot;') %>" data-review="<%= r.content.replace(/"/g, '&quot;') %>" data-chapter="<%= (r.chapter || '').replace(/"/g, '&quot;') %>" title="生成分享图" aria-label="生成分享图">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </footer>
          </article>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bd-empty-block">暂无想法</div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ═══ Notes by Chapter ═══ -->
  <% if (notesByChapter && notesByChapter.length > 0) { %>
  <div class="bd-divider"></div>
  <section class="bd-toc">
    <h3 class="bd-insight-title">全书笔记分布</h3>
    <div class="bd-toc-list">
      <% notesByChapter.forEach(function(c, i) { %>
      <div class="bd-toc-item">
        <span class="bd-toc-index"><%= String(i + 1).padStart(2, '0') %></span>
        <span class="bd-toc-name"><%= c.chapter %></span>
        <span class="bd-toc-count"><%= c.count %> 条笔记</span>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Back to top -->
  <div class="bd-footer-nav">
    <a href="/bookshelf" class="bd-footer-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      返回书架
    </a>
  </div>

</div>

<!-- Share Quote Card — hidden -->
<div id="share-card-host" style="position:fixed;left:-9999px;top:0;z-index:0;"></div>

<!-- Share Preview Modal -->
<div id="share-modal" class="share-modal" aria-hidden="true">
  <div class="share-modal-backdrop"></div>
  <div class="share-modal-body">
    <div class="share-modal-header">
      <span class="share-modal-title">分享卡片预览</span>
      <button class="share-modal-close" id="share-modal-close" aria-label="关闭">&times;</button>
    </div>
    <div class="share-modal-preview">
      <img id="share-preview-img" src="" alt="分享卡片预览">
    </div>
    <div class="share-modal-actions">
      <button class="share-modal-btn" id="share-download-btn">下载图片</button>
      <button class="share-modal-btn share-modal-btn-outline" id="share-copy-btn">复制图片</button>
    </div>
  </div>
</div>

<script>
(function() {
  "use strict";

  function waitForHtml2Canvas() {
    return new Promise(function(resolve, reject) {
      if (window.html2canvas) return resolve();
      var tries = 0;
      var timer = setInterval(function() {
        tries++;
        if (window.html2canvas) { clearInterval(timer); resolve(); }
        else if (tries > 30) { clearInterval(timer); reject(new Error("html2canvas timeout")); }
      }, 200);
    });
  }

  function themeColor(light, dark) {
    return document.documentElement.getAttribute("data-theme") === "dark" ? dark : light;
  }

  function escapeHtml(s) {
    return s.replace(/&/g, "&amp;")
           .replace(/</g, "&lt;")
           .replace(/>/g, "&gt;")
           .replace(/"/g, "&quot;")
           .replace(/'/g, "&#39;");
  }

  function buildShareCard(text, chapter, bookTitle, bookAuthor) {
    var paper    = themeColor("#faf9f5", "#161615");
    var ink      = themeColor("#171717", "#e8e6e0");
    var inkSoft  = themeColor("#3d3d3d", "#b0aea8");
    var inkMuted = themeColor("#8a8a85", "#706e68");
    var rule     = themeColor("#e0ded8", "#2a2a26");
    var accent   = themeColor("#2c5282", "#93bfec");

    var QL = "\u201C";
    var MD = "\u2014";
    var LS = "\u300A";
    var RS = "\u300B";
    var DOT = "\u00B7";

    return (
      '<div id="share-card-inner" style="' +
      "width:1400px;height:900px;" +
      "background:" + paper + ";" +
      "display:flex;flex-direction:column;justify-content:center;align-items:center;" +
      "padding:90px 110px;box-sizing:border-box;position:relative;" +
      "font-family:serif;overflow:hidden;" +
      '">' +
      '<div style="' +
      "position:absolute;top:70px;left:90px;" +
      "font-size:160px;line-height:1;" +
      "color:" + accent + ";opacity:0.07;font-family:serif;user-select:none;" +
      '">' + QL + "</div>" +
      '<div style="' +
      "position:absolute;bottom:70px;right:90px;" +
      "font-size:120px;line-height:1;" +
      "color:" + accent + ";opacity:0.05;font-family:serif;user-select:none;" +
      "transform:scaleX(-1);" +
      '">' + QL + "</div>" +
      '<div style="' +
      "position:absolute;top:0;left:90px;right:90px;" +
      "height:2px;background:" + accent + ";opacity:0.3;" +
      '"></div>' +
      '<div style="' +
      "position:absolute;bottom:0;left:90px;right:90px;" +
      "height:2px;background:" + accent + ";opacity:0.3;" +
      '"></div>' +
      '<div style="' +
      "max-width:1050px;text-align:center;position:relative;z-index:1;" +
      '">' +
      "<p style=\"" +
      "font-family:serif;font-size:36px;line-height:1.7;color:" + ink + ";" +
      "margin:0 0 32px 0;letter-spacing:0.02em;" +
      "\">" + escapeHtml(text) + "</p>" +
      (chapter ? "<p style=\"" +
      "font-size:17px;color:" + inkMuted + ";margin:0 0 28px 0;letter-spacing:0.08em;" +
      "\">" + MD + " " + escapeHtml(chapter) + "</p>" : "") +
      '<div style="' +
      "width:70px;height:1px;background:" + rule + ";margin:0 auto 28px auto;" +
      '"></div>' +
      "<p style=\"" +
      "font-size:18px;color:" + inkSoft + ";margin:0;font-weight:600;letter-spacing:0.04em;" +
      "\">" + LS + escapeHtml(bookTitle) + RS +
      (bookAuthor ? " " + DOT + " " + escapeHtml(bookAuthor) : "") +
      "</p>" +
      "</div>" +
      "</div>"
    );
  }

  function buildReviewShareCard(quote, review, chapter, bookTitle, bookAuthor) {
    var paper    = themeColor("#faf9f5", "#161615");
    var ink      = themeColor("#171717", "#e8e6e0");
    var inkSoft  = themeColor("#3d3d3d", "#b0aea8");
    var inkMuted = themeColor("#8a8a85", "#706e68");
    var accent   = themeColor("#e07a5f", "#d4846e");
    var accent2  = themeColor("#2c5282", "#93bfec");

    var MD = "\u2014";
    var DOT = "\u00B7";

    var html = (
      '<div id="share-card-inner" style="' +
      "width:1400px;height:900px;" +
      "background:" + paper + ";" +
      "display:flex;flex-direction:column;justify-content:center;align-items:center;" +
      "padding:90px 110px;box-sizing:border-box;position:relative;" +
      "font-family:serif;overflow:hidden;" +
      '">'
    );

    if (quote) {
      html += (
        '<div style="' +
        "position:relative;max-width:1050px;margin-bottom:40px;padding:0 20px;" +
        '">' +
        '<div style="' +
        "position:absolute;left:0;top:0;bottom:0;width:3px;" +
        "background:" + accent2 + ";opacity:0.25;border-radius:2px;" +
        '"></div>' +
        "<p style=\"" +
        "font-family:serif;font-size:22px;line-height:1.6;color:" + ink + ";opacity:0.65;" +
        "margin:0 0 0 24px;letter-spacing:0.01em;font-style:italic;" +
        "\">" + escapeHtml(quote) + "</p>" +
        "</div>"
      );
    }

    html += (
      '<div style="' +
      "max-width:1050px;text-align:center;position:relative;z-index:1;" +
      '">' +
      "<p style=\"" +
      "font-family:serif;font-size:32px;line-height:1.75;color:" + ink + ";" +
      "margin:0 0 28px 0;letter-spacing:0.02em;" +
      "\">" + escapeHtml(review) + "</p>"
    );

    if (chapter) {
      html += "<p style=\"" +
        "font-size:15px;color:" + inkMuted + ";margin:0 0 24px 0;letter-spacing:0.08em;" +
        "\">" + MD + " " + escapeHtml(chapter) + "</p>";
    }

    html += (
      '<div style="' +
      "width:50px;height:2px;background:" + accent + ";opacity:0.4;margin:0 auto 24px auto;border-radius:1px;" +
      '"></div>' +
      "<p style=\"" +
      "font-size:13px;color:" + accent + ";margin:0 0 16px 0;letter-spacing:0.2em;text-transform:uppercase;opacity:0.7;" +
      "\">\u6211\u7684\u60F3\u6CD5</p>" +
      "<p style=\"" +
      "font-size:16px;color:" + inkSoft + ";margin:0;font-weight:600;letter-spacing:0.04em;" +
      "\">" + escapeHtml(bookTitle) +
      (bookAuthor ? " " + DOT + " " + escapeHtml(bookAuthor) : "") +
      "</p>"
    );

    html += "</div></div>";
    return html;
  }

  // Click handler for share buttons
  document.addEventListener("click", function(e) {
    var hlBtn = e.target.closest(".highlight-share-btn");
    if (hlBtn) {
      e.preventDefault();
      var text = hlBtn.getAttribute("data-text") || "";
      var chapter = hlBtn.getAttribute("data-chapter") || "";
      var container = document.querySelector(".bd-container");
      var bookTitle = container ? (container.getAttribute("data-book-title") || "") : "";
      var bookAuthor = container ? (container.getAttribute("data-book-author") || "") : "";
      generateAndShow(buildShareCard(text, chapter, bookTitle, bookAuthor));
      return;
    }

    var rvBtn = e.target.closest(".review-share-btn");
    if (rvBtn) {
      e.preventDefault();
      var quote = rvBtn.getAttribute("data-quote") || "";
      var review = rvBtn.getAttribute("data-review") || "";
      var chapter = rvBtn.getAttribute("data-chapter") || "";
      var container = document.querySelector(".bd-container");
      var bookTitle = container ? (container.getAttribute("data-book-title") || "") : "";
      var bookAuthor = container ? (container.getAttribute("data-book-author") || "") : "";
      generateAndShow(buildReviewShareCard(quote, review, chapter, bookTitle, bookAuthor));
      return;
    }
  });

  function generateAndShow(html) {
    var host = document.getElementById("share-card-host");
    if (!host) return;
    host.innerHTML = html;

    var card = document.getElementById("share-card-inner");
    if (!card) { host.innerHTML = ""; return; }

    var overlay = document.createElement("div");
    overlay.id = "share-loading-overlay";
    overlay.style.cssText = "position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;letter-spacing:0.1em;";
    overlay.textContent = "\u6B63\u5728\u751F\u6210\u5206\u4EAB\u56FE\u2026";
    document.body.appendChild(overlay);
    overlay.offsetHeight;

    requestAnimationFrame(function() {
      host.style.left = "0";
      host.style.top = "0";
      host.style.zIndex = "99990";
      host.style.opacity = "0";
      host.style.maxWidth = "100vw";
      host.style.maxHeight = "100vh";
      host.style.overflow = "hidden";

      Promise.all([
        waitForHtml2Canvas(),
        document.fonts ? document.fonts.ready : Promise.resolve()
      ]).then(function() {
        return html2canvas(card, {
          backgroundColor: null,
          scale: 2,
          useCORS: true,
          logging: false,
          onclone: function(clonedDoc) {
            var el = clonedDoc.getElementById("share-card-inner");
            if (el) el.style.opacity = "1";
            var link = clonedDoc.createElement("link");
            link.rel = "stylesheet";
            link.href = "https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&display=swap";
            clonedDoc.head.appendChild(link);
          }
        });
      }).then(function(canvas) {
        showModal(canvas);
      }).catch(function(err) {
        console.error("[share] error:", err);
        alert("生成分享图失败：" + (err.message || err));
      }).finally(function() {
        host.innerHTML = "";
        host.style.left = "-9999px";
        host.style.zIndex = "0";
        host.style.opacity = "";
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
      });
    });
  }

  function showModal(canvas) {
    var modal = document.getElementById("share-modal");
    var img = document.getElementById("share-preview-img");
    if (!modal || !img) return;

    var dataUrl = canvas.toDataURL("image/png");
    img.src = dataUrl;
    modal.setAttribute("aria-hidden", "false");
    modal.classList.add("is-open");

    var dlBtn = document.getElementById("share-download-btn");
    if (dlBtn) {
      dlBtn.onclick = function() {
        var a = document.createElement("a");
        a.href = dataUrl;
        a.download = "quote-share.png";
        a.click();
      };
    }

    var cpBtn = document.getElementById("share-copy-btn");
    if (cpBtn) {
      cpBtn.onclick = function() {
        canvas.toBlob(function(blob) {
          if (!blob) { alert("复制失败"); return; }
          navigator.clipboard.write([
            new ClipboardItem({ "image/png": blob })
          ]).then(function() {
            cpBtn.textContent = "已复制 ✓";
            setTimeout(function() { cpBtn.textContent = "复制图片"; }, 1500);
          }).catch(function() {
            alert("复制失败，请尝试下载图片");
          });
        }, "image/png");
      };
    }
  }

  function closeModal() {
    var modal = document.getElementById("share-modal");
    if (modal) {
      modal.setAttribute("aria-hidden", "true");
      modal.classList.remove("is-open");
    }
  }

  var closeBtn = document.getElementById("share-modal-close");
  if (closeBtn) closeBtn.addEventListener("click", closeModal);
  var backdrop = document.querySelector(".share-modal-backdrop");
  if (backdrop) backdrop.addEventListener("click", closeModal);
})();
</script>
