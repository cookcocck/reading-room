<!-- ═══════════════════════════════════════════
   BOOKSHELF — Editorial Book Catalog
   ═══════════════════════════════════════════ -->

<div class="container-bookshelf">
  <div class="catalog-header">
    <h1>书架</h1>
    <div class="catalog-count"><%= books.length %> 册藏书 · <%= summary.finishedCount %> 册已读完</div>
  </div>

  <!-- Filters — editorial text links -->
  <div class="catalog-filters">
    <a href="/bookshelf" class="filter-option <%= filter === 'all' && !category ? 'active' : '' %>">全部</a>
    <a href="/bookshelf?filter=reading" class="filter-option <%= filter === 'reading' ? 'active' : '' %>">在读</a>
    <a href="/bookshelf?filter=finished" class="filter-option <%= filter === 'finished' ? 'active' : '' %>">已读完</a>
    <% if (category) { %>
      <span class="filter-option active"><%= category %> <a href="/bookshelf?filter=<%= filter %>" style="margin-left: 4px; font-size: 0.75rem;">×</a></span>
    <% } %>
  </div>

  <!-- Category tags (when no specific category selected) -->
  <% if (!category && allCategories.length > 0) { %>
  <div class="category-filters">
    <% allCategories.slice(0, 12).forEach(function(c) { %>
    <a href="/bookshelf?category=<%= encodeURIComponent(c) %>" class="category-tag"><%= c %></a>
    <% }); %>
  </div>
  <% } %>

  <!-- Book Card Grid -->
  <% if (books.length > 0) { %>
  <div class="book-card-grid">
    <% books.forEach(function(b) { %>
    <div class="book-card" onclick="openBookModal('<%= b.id %>')">
      <div class="book-card-cover">
        <% if (b.cover) { %><img src="<%= b.cover %>" alt="" loading="lazy" onerror="this.style.display='none';this.parentElement.innerHTML='📖'"><% } else { %>📖<% } %>
      </div>
      <div class="book-card-body">
        <div class="book-card-title"><%= b.title %></div>
        <div class="book-card-author"><%= b.author || '佚名' %></div>
        <% if (b.finished) { %><span class="book-card-badge">已读完</span><% } %>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-state-icon">—</div>
    <p class="empty-state-text">没有符合条件的藏书</p>
  </div>
  <% } %>
</div>
