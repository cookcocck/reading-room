# ─── 黄氏书房 环境变量配置示例 ─────────────────────────────────────────────
# 复制本文件为 .env，并填入真实值：
#   cp .env.example .env
#
# .env 文件已被 .gitignore 排除，不会提交到 Git。
# ────────────────────────────────────────────────────────────────────────────

# 【必须】微信读书 API Key
# 获取方式：在 WorkBuddy 中使用 WeRead Skill，复制 API Key
WEREAD_API_KEY=wrk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【可选】PM2 应用名（默认 reading-room）
# 如果你的 PM2 应用名不同，在此修改
PM2_APP_NAME=reading-room

# 【可选】Node.js 服务端口（默认 3000）
PORT=3000
