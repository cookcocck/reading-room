<!-- ═══════════════════════════════════════════
   HOME — Stardew Valley Pixel Style
   ═══════════════════════════════════════════ -->

<%
// Parse heatmap data for rendering
var heatmapData = typeof heatmap === 'string' ? JSON.parse(heatmap) : (heatmap || []);
var heatmapMap = {};
heatmapData.forEach(function(d) { heatmapMap[d.date] = d.seconds; });

function heatmapLevel(seconds) {
  if (!seconds || seconds <= 0) return 0;
  if (seconds < 600) return 1;
  if (seconds < 1800) return 2;
  if (seconds < 3600) return 3;
  return 4;
}

// Parse monthly 2025 data
var monthly2025Data = typeof monthly2025 === 'string' ? JSON.parse(monthly2025) : (monthly2025 || []);

// Build heatmap grid
var MONTHS = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
var WEEKD = ['一','二','三','四','五','六','日'];
var year = 2026;
var startDate = new Date(year, 0, 1);
var startDow = startDate.getDay();
var mondayOffset = startDow === 0 ? -6 : 1 - startDow;
var gridStart = new Date(year, 0, 1 + mondayOffset);
var today = new Date();
var todayStr = today.toISOString().slice(0, 10);

var totalWeeks = 53;
var cells = [];
var monthPositions = {};

for (var w = 0; w < totalWeeks; w++) {
  for (var d = 0; d < 7; d++) {
    var cellDate = new Date(gridStart);
    cellDate.setDate(gridStart.getDate() + w * 7 + d);
    var dateStr = cellDate.toISOString().slice(0, 10);
    var month = cellDate.getMonth();
    var inYear = cellDate.getFullYear() === year;
    var isAfter = dateStr > todayStr;
    var seconds = heatmapMap[dateStr] || 0;

    if (inYear && !(month in monthPositions) && d === 0) {
      monthPositions[month] = w;
    }

    cells.push({
      date: dateStr, dow: d, week: w, month: month,
      inYear: inYear, isAfter: isAfter, seconds: seconds,
      level: typeof heatmapLevel === 'function' ? heatmapLevel(seconds) : 0
    });
  }
}

// Month label row
var monthLabelRow = [];
for (var w = 0; w < totalWeeks; w++) { monthLabelRow[w] = null; }
for (var m = 0; m < 12; m++) {
  if (monthPositions[m] !== undefined) monthLabelRow[monthPositions[m]] = MONTHS[m];
}

// Totals
var total2026Seconds = heatmapData.reduce(function(sum, d) { return sum + (d.seconds || 0); }, 0);
var total2026Hours = Math.round(total2026Seconds / 3600);
var readingDays2026 = heatmapData.filter(function(d) { return d.seconds > 0; }).length;
var maxDaySeconds = Math.max.apply(null, heatmapData.map(function(d) { return d.seconds || 0; }));
var maxDayStr = maxDaySeconds > 0 ? formatTime(maxDaySeconds) : '0m';
var maxWeekday = Math.max.apply(null, weekdayCounts) || 1;

// ═══ 游戏化数据 ═══
var totalHours = Math.round((overall.totalReadTimeSec || 0) / 3600);
var playerLevel = Math.floor(totalHours / 50) + 1;
var expInLevel = totalHours % 50;
var expPercent = Math.round(expInLevel / 50 * 100);
var coins = (summary.totalNoteCount || 0) * 5 + (overall.readDays || 0) * 2;
var hearts = Math.min(5, Math.floor((hpStats.currentStreak || 0) / 3) + (hpStats.todayRead ? 1 : 0));
var emptyHearts = 5 - hearts;

// 季节
var nowMonth = today.getMonth() + 1;
var season = nowMonth >= 3 && nowMonth <= 5 ? 'spring' : (nowMonth >= 6 && nowMonth <= 8 ? 'summer' : (nowMonth >= 9 && nowMonth <= 11 ? 'fall' : 'winter'));
var seasonNames = { spring: '🌸 春季', summer: '☀️ 夏季', fall: '🍂 秋季', winter: '❄️ 冬季' };
var seasonName = seasonNames[season];

// NPC 对话
var npcMessage = '';
if (!hpStats.todayRead) {
  npcMessage = hpStats.currentStreak > 0 
    ? '早上好！你已经连续阅读 ' + hpStats.currentStreak + ' 天了，今天也别忘了打开书哦~'
    : '早上好！新的一天，从读一页书开始吧~';
} else {
  npcMessage = '今天已经读过书啦，真棒！继续保持，农场主~';
}

// 每日任务
var dailyTasks = [
  { name: '今日阅读', target: 1, current: hpStats.todayRead ? 1 : 0, unit: '次', reward: 10 },
  { name: '阅读30分钟', target: 1800, current: Math.min(1800, heatmapMap[todayStr] || 0), unit: '秒', reward: 20, isTime: true },
  { name: '写一条笔记', target: 1, current: 0, unit: '条', reward: 15 },
  { name: '连续阅读', target: 7, current: hpStats.currentStreak || 0, unit: '天', reward: 50 },
];
%>

<!-- ═══ 游戏状态栏 ═══ -->
<div class="game-status-bar">
  <div class="gsb-left">
    <div class="gsb-level">
      <div class="gsb-level-badge">Lv.<%= playerLevel %></div>
      <div class="gsb-exp">
        <div class="gsb-exp-fill" style="width: <%= expPercent %>%"></div>
        <span class="gsb-exp-text"><%= expInLevel %>/50 EXP</span>
      </div>
    </div>
  </div>
  <div class="gsb-center">
    <div class="gsb-hearts">
      <% for (var i = 0; i < hearts; i++) { %><span class="heart full"></span><% } %>
      <% for (var i = 0; i < emptyHearts; i++) { %><span class="heart empty"></span><% } %>
    </div>
  </div>
  <div class="gsb-right">
    <div class="gsb-coins"><span class="coin-icon"></span><%= coins.toLocaleString() %></div>
    <div class="gsb-date"><%= seasonName %> · <%= today.getMonth()+1 %>月<%= today.getDate() %>日</div>
  </div>
</div>

<!-- ═══ NPC 对话框 ═══ -->
<div class="container-wide">
  <div class="npc-dialog">
    <div class="npc-avatar">👨‍🌾</div>
    <div class="npc-bubble">
      <div class="npc-name">书房管理员</div>
      <div class="npc-text"><%= npcMessage %></div>
    </div>
  </div>
</div>

<!-- ═══ 每日任务 + 技能面板 ═══ -->
<div class="container-wide">
  <div class="game-two-col">
    <!-- 每日任务 -->
    <div class="game-panel">
      <div class="game-panel-title">📋 今日任务</div>
      <div class="task-list">
        <% dailyTasks.forEach(function(task) { 
          var done = task.current >= task.target;
          var pct = Math.min(100, Math.round(task.current / task.target * 100));
        %>
        <div class="task-item <%= done ? 'done' : '' %>">
          <div class="task-check"><%= done ? '✓' : '○' %></div>
          <div class="task-info">
            <div class="task-name"><%= task.name %></div>
            <div class="task-progress">
              <div class="task-progress-fill" style="width: <%= pct %>%"></div>
            </div>
            <div class="task-count">
              <%= task.isTime ? (task.current >= 60 ? Math.floor(task.current/60) + '分' : task.current + '秒') : task.current %>/<%= task.isTime ? '30分' : task.target + task.unit %>
            </div>
          </div>
          <div class="task-reward">+<%= task.reward %>🪙</div>
        </div>
        <% }); %>
      </div>
    </div>

    <!-- 技能面板 -->
    <div class="game-panel">
      <div class="game-panel-title">⚔️ 阅读技能</div>
      <div class="skill-list">
        <div class="skill-item">
          <div class="skill-icon">📚</div>
          <div class="skill-info">
            <div class="skill-name">藏书家 <span class="skill-level">Lv.<%= Math.floor(summary.totalBooks / 20) + 1 %></span></div>
            <div class="skill-bar"><div class="skill-bar-fill" style="width: <%= (summary.totalBooks % 20) / 20 * 100 %>%"></div></div>
          </div>
        </div>
        <div class="skill-item">
          <div class="skill-icon">✍️</div>
          <div class="skill-info">
            <div class="skill-name">笔记达人 <span class="skill-level">Lv.<%= Math.floor((summary.totalNoteCount || 0) / 100) + 1 %></span></div>
            <div class="skill-bar"><div class="skill-bar-fill" style="width: <%= ((summary.totalNoteCount || 0) % 100) / 100 * 100 %>%"></div></div>
          </div>
        </div>
        <div class="skill-item">
          <div class="skill-icon">⏱️</div>
          <div class="skill-info">
            <div class="skill-name">阅读时长 <span class="skill-level">Lv.<%= playerLevel %></span></div>
            <div class="skill-bar"><div class="skill-bar-fill" style="width: <%= expPercent %>%"></div></div>
          </div>
        </div>
        <div class="skill-item">
          <div class="skill-icon">🔥</div>
          <div class="skill-info">
            <div class="skill-name">连续阅读 <span class="skill-level">Lv.<%= Math.floor((hpStats.currentStreak || 0) / 7) + 1 %></span></div>
            <div class="skill-bar"><div class="skill-bar-fill" style="width: <%= ((hpStats.currentStreak || 0) % 7) / 7 * 100 %>%"></div></div>
          </div>
        </div>
        <div class="skill-item">
          <div class="skill-icon">✅</div>
          <div class="skill-info">
            <div class="skill-name">读完率 <span class="skill-level">Lv.<%= Math.floor(summary.finishedCount / 10) + 1 %></span></div>
            <div class="skill-bar"><div class="skill-bar-fill" style="width: <%= (summary.finishedCount % 10) / 10 * 100 %>%"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ 农场统计 ═══ -->
<div class="container-wide">
  <div class="game-panel">
    <div class="game-panel-title">🏡 农场概况</div>
    <div class="farm-stats">
      <div class="farm-stat">
        <div class="farm-stat-icon">📚</div>
        <div class="farm-stat-num"><%= summary.totalBooks %></div>
        <div class="farm-stat-label">册藏书</div>
      </div>
      <div class="farm-stat">
        <div class="farm-stat-icon">✅</div>
        <div class="farm-stat-num"><%= summary.finishedCount %></div>
        <div class="farm-stat-label">已读完</div>
      </div>
      <div class="farm-stat">
        <div class="farm-stat-icon">✏️</div>
        <div class="farm-stat-num"><%= (summary.totalNoteCount || 0).toLocaleString() %></div>
        <div class="farm-stat-label">条笔记</div>
      </div>
      <div class="farm-stat">
        <div class="farm-stat-icon">⏰</div>
        <div class="farm-stat-num"><%= totalHours.toLocaleString() %><span class="unit">h</span></div>
        <div class="farm-stat-label">累计阅读</div>
      </div>
      <div class="farm-stat">
        <div class="farm-stat-icon">📅</div>
        <div class="farm-stat-num"><%= (overall.readDays || 0).toLocaleString() %></div>
        <div class="farm-stat-label">天在读书</div>
      </div>
      <div class="farm-stat">
        <div class="farm-stat-icon">🔥</div>
        <div class="farm-stat-num"><%= hpStats.currentStreak || 0 %></div>
        <div class="farm-stat-label">连续天数</div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ 热力图 ═══ -->
<div class="container-wide">
  <div class="game-panel">
    <div class="game-panel-title">📊 <%= year %> 年阅读日历</div>
    <div class="heatmap-summary">
      累计 <strong><%= total2026Hours %>h</strong> · <%= readingDays2026 %> 天在读书 · 最长单日 <strong><%= maxDayStr %></strong>
    </div>

    <!-- Month labels -->
    <div style="display: flex; gap: 3px; margin-bottom: 4px; padding-left: 28px;">
      <% for (var w = 0; w < totalWeeks; w++) { %>
        <% if (monthLabelRow[w]) { %>
          <span class="heatmap-month-label" style="width: 11px; text-align: left; white-space: nowrap; position: relative; left: -4px;"><%= monthLabelRow[w] %></span>
        <% } else { %>
          <div style="width: 11px;"></div>
        <% } %>
      <% } %>
    </div>

    <!-- Grid: 7 rows × 53 columns -->
    <div class="heatmap-grid">
      <% for (var d = 0; d < 7; d++) { %>
        <div style="display: flex; gap: 3px; align-items: center; height: 13px;">
          <span style="width: 20px; text-align: right; font-size: 9px; color: var(--ink-muted); flex-shrink: 0; margin-right: 5px;"><%= WEEKD[d] %></span>
          <% for (var w = 0; w < totalWeeks; w++) {
            var idx = w * 7 + d;
            var cell = cells[idx];
            if (!cell || !cell.inYear || cell.isAfter) { %>
              <div class="heatmap-cell level-0" style="visibility: hidden;"></div>
            <% } else { %>
              <div class="heatmap-cell level-<%= cell.level %>" data-date="<%= cell.date %>">
                <div class="heatmap-tooltip"><%= cell.date %> · <%= cell.seconds > 0 ? helpers.formatTime(cell.seconds) : '未阅读' %></div>
              </div>
            <% } %>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Legend -->
    <div class="heatmap-legend" style="margin-top: 8px; padding-left: 28px;">
      <span style="font-size: 10px;">少</span>
      <div class="dot level-0"></div>
      <div class="dot level-1"></div>
      <div class="dot level-2"></div>
      <div class="dot level-3"></div>
      <div class="dot level-4"></div>
      <div class="dot level-5"></div>
      <span style="font-size: 10px;">多</span>
    </div>
  </div>
</div>

<!-- ═══ 正在阅读 ═══ -->
<% if (currentlyReading && currentlyReading.length > 0) { %>
<div class="container-wide">
  <div class="game-panel">
    <div class="game-panel-title">📖 正在阅读</div>
    <div class="reading-now-list">
      <% currentlyReading.forEach(function(b) { %>
      <div class="reading-item">
        <div class="reading-item-cover">
          <% if (b.cover) { %><img src="<%= b.cover %>" alt="" loading="lazy" onerror="this.style.display='none'"><% } else { %>📖<% } %>
        </div>
        <div class="reading-item-info">
          <div class="reading-item-title"><%= b.title %></div>
          <div class="reading-item-author"><%= b.author %></div>
          <% if (b.progress && b.progress > 0) { %>
          <div class="reading-item-progress">
            <div class="reading-item-progress-fill" style="width: <%= b.progress %>%"></div>
            <span><%= b.progress %>%</span>
          </div>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- ═══ 阅读摘录 ═══ -->
<% if (recentHighlights && recentHighlights.length > 0) { %>
<div class="container-wide">
  <div class="game-panel">
    <div class="game-panel-title">💬 阅读摘录</div>
    <div class="highlights-list" id="home-highlights">
      <% recentHighlights.slice(0, 6).forEach(function(h) { %>
      <div class="highlight-block">
        <div class="highlight-text"><%= h.markText || h.content || '' %></div>
        <div class="highlight-source">
          — <%= h.bookTitle || '未知书名' %>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- ═══ 年度之书 ═══ -->
<% if (annual.topBooks && annual.topBooks.length > 0) { %>
<div class="container-wide">
  <div class="game-panel">
    <div class="game-panel-title">🏆 年度之书</div>
    <div class="book-card-grid">
      <% annual.topBooks.slice(0, 6).forEach(function(b) { %>
      <div class="book-card" onclick="window.location.href='/bookshelf'">
        <div class="book-card-cover">
          <% if (b.cover) { %><img src="<%= b.cover %>" alt="" loading="lazy" onerror="this.style.display='none'"><% } else { %>📖<% } %>
        </div>
        <div class="book-card-body">
          <div class="book-card-title"><%= b.title %></div>
          <div class="book-card-author"><%= b.author %></div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- ═══ 季节装饰底部 ═══ -->
<div class="season-footer">
  <% if (season === 'spring') { %>
    🌱🌷🌼🌸🌻🌱🌷🌼🌸🌻🌱🌷🌼🌸🌻
  <% } else if (season === 'summer') { %>
    ☀️🌻🍉🌴🌊☀️🌻🍉🌴🌊☀️🌻🍉🌴🌊
  <% } else if (season === 'fall') { %>
    🍂🍁🌰🎃🍎🍂🍁🌰🎃🍎🍂🍁🌰🎃🍎
  <% } else { %>
    ❄️⛄🎄🔥❄️⛄🎄🔥❄️⛄🎄🔥❄️⛄
  <% } %>
</div>
