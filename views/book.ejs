<!-- ═══════════════════════════════════════
   BOOK DETAIL — Full-page book view
   ═══════════════════════════════════════ -->
<div class="container-wide" data-book-title="<%= book.title.replace(/"/g, '&quot;') %>" data-book-author="<%= (book.author || '').replace(/"/g, '&quot;') %>">
  <a href="/bookshelf" class="back-link">&larr; 返回书架</a>

  <div class="book-detail-top">
    <!-- Left column: Book info -->
    <div class="book-detail-left">
      <div class="book-detail-cover">
        <% if (book.cover) { %>
          <img src="<%= book.cover %>" alt="" onerror="this.style.display='none';this.parentElement.innerHTML='&#128218;'">
        <% } else { %>
          &#128218;
        <% } %>
      </div>

      <h1 class="book-detail-title"><%= book.title %></h1>
      <div class="book-detail-author"><%= book.author || '佚名' %></div>

      <div class="book-detail-meta">
        <% if (book.category) { %><span class="book-detail-tag"><%= book.category %></span><% } %>
        <% if (book.finished) { %><span class="book-detail-tag done">已读完</span><% } else { %><span class="book-detail-tag reading">在读</span><% } %>
      </div>

      <!-- Reading Stats — always show -->
      <div class="book-detail-stats">
        <div class="detail-stat">
          <span class="detail-stat-value"><%= helpers.formatTime(readTimeSec) %></span>
          <span class="detail-stat-label">阅读时长</span>
        </div>
        <% if (book.notebook) { %>
          <% if (book.notebook.noteCount > 0) { %>
          <div class="detail-stat">
            <span class="detail-stat-value"><%= book.notebook.noteCount %></span>
            <span class="detail-stat-label">划线</span>
          </div>
          <% } %>
          <% if (book.notebook.reviewCount > 0) { %>
          <div class="detail-stat">
            <span class="detail-stat-value"><%= book.notebook.reviewCount %></span>
            <span class="detail-stat-label">想法</span>
          </div>
          <% } %>
          <% if (book.notebook.bookmarkCount > 0) { %>
          <div class="detail-stat">
            <span class="detail-stat-value"><%= book.notebook.bookmarkCount %></span>
            <span class="detail-stat-label">书签</span>
          </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Book Intro — full width -->
  <% if (intro) { %>
  <div class="detail-intro-section">
    <div class="detail-insight-card" id="book-intro-card">
      <div class="section-kicker">书籍简介</div>
      <div class="book-intro-body" id="book-intro-body">
        <p><%= intro %></p>
      </div>
      <% if (intro.length > 200) { %>
      <button class="intro-toggle" id="intro-toggle" onclick="
        var b=document.getElementById('book-intro-body');
        var t=document.getElementById('intro-toggle');
        b.classList.toggle('expanded');
        t.textContent = b.classList.contains('expanded') ? '收起' : '展开全文';
      ">展开全文</button>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- 阅读足迹 + 章节热度 row -->
  <% if ((monthlyBars && monthlyBars.length > 0) || chapterActivity.length > 0) { %>
  <div class="detail-insight-row">
    <!-- 阅读足迹 -->
    <% if (monthlyBars && monthlyBars.length > 0) { %>
    <div class="detail-insight-card">
      <div class="section-kicker">阅读足迹</div>
      <div class="monthly-bars">
        <% monthlyBars.forEach(function(m) { %>
        <div class="monthly-bar-row">
          <div class="monthly-bar-label"><%= m.label %></div>
          <div class="monthly-bar-track">
            <div class="monthly-bar-fill" style="width: <%= Math.round((m.estimatedSec / maxMonthlySec) * 100) %>%;">
              <span class="monthly-bar-time"><%= m.timeLabel %></span>
            </div>
          </div>
          <div class="monthly-bar-arrow">&#9662;</div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } else { %>
    <div class="detail-insight-card">
      <div class="section-kicker">阅读足迹</div>
      <div class="monthly-empty-state">
        <% if (readTimeSec > 0) { %>
          <p class="monthly-empty-total">累计阅读 <%= helpers.formatTime(readTimeSec) %></p>
          <p class="monthly-empty-hint">按月分布数据将在下次同步后显示</p>
        <% } else { %>
          <p class="monthly-empty-hint">暂无月度阅读记录</p>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- 章节热度 -->
    <% if (chapterActivity.length > 0) { %>
    <div class="detail-insight-card">
      <div class="section-kicker">章节热度</div>
      <div class="chapter-bars">
        <% chapterActivity.forEach(function(c, i) { %>
        <div class="chapter-bar-row">
          <div class="chapter-bar-label" title="<%= c.chapter %>"><%= c.chapter.length > 12 ? c.chapter.slice(0,12) + '…' : c.chapter %></div>
          <div class="chapter-bar-track">
            <div class="chapter-bar-fill" style="width: <%= Math.round((c.total / maxChapterTotal) * 100) %>%;">
              <span class="chapter-bar-count"><%= c.total %>条</span>
            </div>
          </div>
          <div class="chapter-bar-detail">
            <% if (c.highlights > 0) { %><span class="chap-dot hl"></span><%= c.highlights %><% } %>
            <% if (c.reviews > 0) { %><span class="chap-dot rv"></span><%= c.reviews %><% } %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
  <% } %>

    <!-- Highlights & Reviews — side by side -->
    <% if (highlights.length > 0 || reviews.length > 0) { %>
    <hr class="section-rule">
    <div class="detail-columns">
      <!-- Left: Highlights -->
      <div class="detail-col">
        <div class="section-head-row">
          <div class="section-kicker">划线摘录</div>
          <% if (highlights.length > 0) { %>
          <button class="shuffle-btn" data-section="highlights" data-book="<%= book.id %>" title="随机换一批">⟳</button>
          <% } %>
        </div>
        <% if (highlights.length > 0) { %>
        <div class="book-highlights" id="book-highlights">
          <% highlights.forEach(function(h) { %>
          <blockquote class="detail-highlight">
            <p><%= h.text %></p>
            <% if (h.chapter) { %><cite>— <%= h.chapter %></cite><% } %>
            <button class="highlight-share-btn" data-text="<%= h.text.replace(/"/g, '&quot;') %>" data-chapter="<%= (h.chapter || '').replace(/"/g, '&quot;') %>" title="生成分享图" aria-label="生成分享图">⤴</button>
          </blockquote>
          <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state empty-state-col">
          <p class="empty-state-text">暂无摘录</p>
        </div>
        <% } %>
      </div>

      <!-- Right: Reviews -->
      <div class="detail-col">
        <div class="section-head-row">
          <div class="section-kicker">我的想法</div>
          <% if (reviews.length > 0) { %>
          <button class="shuffle-btn" data-section="reviews" data-book="<%= book.id %>" title="随机换一批">⟳</button>
          <% } %>
        </div>
        <% if (reviews.length > 0) { %>
        <div class="book-reviews" id="book-reviews">
          <% reviews.forEach(function(r) { %>
          <div class="detail-review">
            <p><%= r.content %></p>
            <cite>
              <% if (r.star > 0) { %>
              <span class="review-stars"><% for (var s=0; s<r.star; s++) { %>&#9733;<% } %></span>
              <% } %>
              <% if (r.chapter) { %>— <%= r.chapter %><% } %>
            </cite>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state empty-state-col">
          <p class="empty-state-text">暂无想法</p>
        </div>
        <% } %>
      </div>
    </div>
    <% } else { %>
    <hr class="section-rule">
    <div class="empty-state">
      <p class="empty-state-text">暂无笔记摘录</p>
    </div>
    <% } %>
  </div>
</div>

<!-- Share Quote Card — hidden, used by html2canvas -->
<div id="share-card-host" style="position:fixed;left:-9999px;top:0;z-index:0;"></div>

<!-- Share Preview Modal -->
<div id="share-modal" class="share-modal" aria-hidden="true">
  <div class="share-modal-backdrop"></div>
  <div class="share-modal-body">
    <div class="share-modal-header">
      <span class="share-modal-title">分享卡片预览</span>
      <button class="share-modal-close" id="share-modal-close" aria-label="关闭">&times;</button>
    </div>
    <div class="share-modal-preview">
      <img id="share-preview-img" src="" alt="分享卡片预览">
    </div>
    <div class="share-modal-actions">
      <button class="share-modal-btn" id="share-download-btn">下载图片</button>
      <button class="share-modal-btn share-modal-btn-outline" id="share-copy-btn">复制图片</button>
    </div>
  </div>
</div>

<script>
(function() {
  "use strict";

  function waitForHtml2Canvas() {
    return new Promise(function(resolve, reject) {
      if (window.html2canvas) return resolve();
      var tries = 0;
      var timer = setInterval(function() {
        tries++;
        if (window.html2canvas) { clearInterval(timer); resolve(); }
        else if (tries > 30) { clearInterval(timer); reject(new Error("html2canvas timeout")); }
      }, 200);
    });
  }

  function themeColor(light, dark) {
    return document.documentElement.getAttribute("data-theme") === "dark" ? dark : light;
  }

  function escapeHtml(s) {
    return s.replace(/&/g, "&amp;")
           .replace(/</g, "&lt;")
           .replace(/>/g, "&gt;")
           .replace(/"/g, "&quot;")
           .replace(/'/g, "&#39;");
  }

  function buildShareCard(text, chapter, bookTitle, bookAuthor) {
    var paper    = themeColor("#faf9f5", "#161615");
    var ink      = themeColor("#171717", "#e8e6e0");
    var inkSoft  = themeColor("#3d3d3d", "#b0aea8");
    var inkMuted = themeColor("#8a8a85", "#706e68");
    var rule     = themeColor("#e0ded8", "#2a2a26");
    var accent   = themeColor("#2c5282", "#93bfec");

    var QL = "\u201C";
    var MD = "\u2014";
    var LS = "\u300A";
    var RS = "\u300B";
    var DOT = "\u00B7";

    return (
      '<div id="share-card-inner" style="' +
      "width:1400px;height:900px;" +
      "background:" + paper + ";" +
      "display:flex;flex-direction:column;justify-content:center;align-items:center;" +
      "padding:90px 110px;box-sizing:border-box;position:relative;" +
      "font-family:serif;overflow:hidden;" +
      '">' +

      // Top-left large quote
      '<div style="' +
      "position:absolute;top:70px;left:90px;" +
      "font-size:160px;line-height:1;" +
      "color:" + accent + ";opacity:0.07;font-family:serif;user-select:none;" +
      '">' + QL + "</div>" +

      // Bottom-right mirrored quote
      '<div style="' +
      "position:absolute;bottom:70px;right:90px;" +
      "font-size:120px;line-height:1;" +
      "color:" + accent + ";opacity:0.05;font-family:serif;user-select:none;" +
      "transform:scaleX(-1);" +
      '">' + QL + "</div>" +

      // Top rule
      '<div style="' +
      "position:absolute;top:0;left:90px;right:90px;" +
      "height:2px;background:" + accent + ";opacity:0.3;" +
      '"></div>' +

      // Bottom rule
      '<div style="' +
      "position:absolute;bottom:0;left:90px;right:90px;" +
      "height:2px;background:" + accent + ";opacity:0.3;" +
      '"></div>' +

      // Central content
      '<div style="' +
      "max-width:1050px;text-align:center;position:relative;z-index:1;" +
      '">' +

      // Quote text
      "<p style=\"" +
      "font-family:serif;font-size:36px;line-height:1.7;color:" + ink + ";" +
      "margin:0 0 32px 0;letter-spacing:0.02em;" +
      "\">" + escapeHtml(text) + "</p>" +

      // Chapter
      (chapter ? "<p style=\"" +
      "font-size:17px;color:" + inkMuted + ";margin:0 0 28px 0;letter-spacing:0.08em;" +
      "\">" + MD + " " + escapeHtml(chapter) + "</p>" : "") +

      // Divider
      '<div style="' +
      "width:70px;height:1px;background:" + rule + ";margin:0 auto 28px auto;" +
      '"></div>' +

      // Book title + author
      "<p style=\"" +
      "font-size:18px;color:" + inkSoft + ";margin:0;font-weight:600;letter-spacing:0.04em;" +
      "\">" + LS + escapeHtml(bookTitle) + RS +
      (bookAuthor ? " " + DOT + " " + escapeHtml(bookAuthor) : "") +
      "</p>" +

      // Branding
      "<p style=\"" +
      "font-size:14px;color:" + inkMuted + ";margin:12px 0 0 0;letter-spacing:0.1em;opacity:0.6;" +
      "\">\u9605\u8BFB\u623F \u00B7 reading room</p>" +

      "</div>" +
      "</div>"
    );
  }

  // Click handler for share buttons
  document.addEventListener("click", function(e) {
    var btn = e.target.closest(".highlight-share-btn");
    if (!btn) return;
    e.preventDefault();
    var text = btn.getAttribute("data-text") || "";
    var chapter = btn.getAttribute("data-chapter") || "";
    var container = document.querySelector(".container-wide");
    var bookTitle = container ? (container.getAttribute("data-book-title") || "") : "";
    var bookAuthor = container ? (container.getAttribute("data-book-author") || "") : "";
    generateAndShow(text, chapter, bookTitle, bookAuthor);
  });

  function generateAndShow(text, chapter, bookTitle, bookAuthor) {
    var host = document.getElementById("share-card-host");
    if (!host) return;
    host.innerHTML = buildShareCard(text, chapter, bookTitle, bookAuthor);

    var card = document.getElementById("share-card-inner");
    if (!card) { host.innerHTML = ""; return; }

    Promise.all([
      waitForHtml2Canvas(),
      document.fonts ? document.fonts.ready : Promise.resolve()
    ]).then(function() {
      return html2canvas(card, {
        backgroundColor: null,
        scale: 2,
        useCORS: true,
        logging: false,
        onclone: function(clonedDoc) {
          var link = clonedDoc.createElement("link");
          link.rel = "stylesheet";
          link.href = "https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&display=swap";
          clonedDoc.head.appendChild(link);
        }
      });
    }).then(function(canvas) {
      showModal(canvas);
      host.innerHTML = "";
    }).catch(function(err) {
      console.error("[share] error:", err);
      alert("生成分享图失败：" + (err.message || err));
      host.innerHTML = "";
    });
  }

  function showModal(canvas) {
    var modal = document.getElementById("share-modal");
    var img = document.getElementById("share-preview-img");
    if (!modal || !img) return;

    var dataUrl = canvas.toDataURL("image/png");
    img.src = dataUrl;
    modal.setAttribute("aria-hidden", "false");
    modal.classList.add("is-open");

    var dlBtn = document.getElementById("share-download-btn");
    if (dlBtn) {
      dlBtn.onclick = function() {
        var a = document.createElement("a");
        a.href = dataUrl;
        a.download = "quote-share.png";
        a.click();
      };
    }

    var cpBtn = document.getElementById("share-copy-btn");
    if (cpBtn) {
      cpBtn.onclick = function() {
        canvas.toBlob(function(blob) {
          if (!blob) { alert("复制失败"); return; }
          navigator.clipboard.write([
            new ClipboardItem({ "image/png": blob })
          ]).then(function() {
            cpBtn.textContent = "已复制 ✓";
            setTimeout(function() { cpBtn.textContent = "复制图片"; }, 1500);
          }).catch(function() {
            alert("复制失败，请尝试下载图片");
          });
        }, "image/png");
      };
    }
  }

  function closeModal() {
    var modal = document.getElementById("share-modal");
    if (modal) {
      modal.setAttribute("aria-hidden", "true");
      modal.classList.remove("is-open");
    }
  }

  var closeBtn = document.getElementById("share-modal-close");
  if (closeBtn) closeBtn.addEventListener("click", closeModal);
  var backdrop = document.querySelector(".share-modal-backdrop");
  if (backdrop) backdrop.addEventListener("click", closeModal);
})();
</script>
