<div class="ad-container">

  <!-- Hero -->
  <header class="ad-hero">
    <a href="/authors" class="ad-back">&larr; 返回作者图谱</a>
    <h1 class="ad-name"><%= author.author %></h1>
    <div class="ad-hero-stats">
      <div class="ad-stat">
        <span class="ad-stat-num"><%= books.length %></span>
        <span class="ad-stat-label">本书</span>
      </div>
      <div class="ad-stat">
        <span class="ad-stat-num"><%= helpers.formatTime(totalReadTime) %></span>
        <span class="ad-stat-label">阅读</span>
      </div>
      <div class="ad-stat">
        <span class="ad-stat-num"><%= totalFinished %></span>
        <span class="ad-stat-label">本读完</span>
      </div>
      <div class="ad-stat">
        <span class="ad-stat-num"><%= totalNotes %></span>
        <span class="ad-stat-label">条笔记</span>
      </div>
    </div>
  </header>

  <!-- Reading Period -->
  <% if (firstRead) { %>
  <div class="ad-period">
    <span class="ad-period-label">阅读时段</span>
    <span class="ad-period-range"><%= helpers.formatTimestamp(firstRead) %> — <%= helpers.formatTimestamp(lastRead) %></span>
  </div>
  <% } %>

  <!-- Category Tags -->
  <% if (categories.length > 0) { %>
  <div class="ad-categories">
    <% categories.forEach(function(cat) { %>
    <span class="ad-cat-tag"><%= cat.name %><small> ·<%= cat.count %></small></span>
    <% }); %>
  </div>
  <% } %>

  <!-- Books Timeline -->
  <section class="ad-books-section">
    <h2 class="ad-section-title">作品阅读轨迹</h2>
    <div class="ad-books-grid">
      <% books.forEach(function(book) { %>
      <a href="/book/<%= book.id %>" class="ad-book-card">
        <!-- Cover -->
        <div class="ad-book-cover">
          <% if (book.cover) { %>
          <img src="<%= book.cover %>" alt="<%= book.title %>" loading="lazy" />
          <% } else { %>
          <div class="ad-book-no-cover">
            <span class="ad-book-no-cover-icon">📖</span>
          </div>
          <% } %>
        </div>
        <!-- Info -->
        <div class="ad-book-body">
          <h3 class="ad-book-title"><%= book.title %></h3>
          <% if (book.category) { %>
          <span class="ad-book-cat"><%= book.category %></span>
          <% } %>
          <!-- Read time bar -->
          <div class="ad-book-bar-wrap">
            <div class="ad-book-bar" style="width: <%= Math.max((book.read_time || 0) / maxReadTime * 100, 2) %>%"></div>
          </div>
          <div class="ad-book-meta">
            <span class="ad-book-time"><%= helpers.formatTime(book.read_time || 0) %></span>
            <% if (book.finished) { %>
            <span class="ad-book-finished">✓ 已读完</span>
            <% } else { %>
            <span class="ad-book-reading">阅读中</span>
            <% } %>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
  </section>

  <!-- Highlights from this author -->
  <% if (highlights.length > 0) { %>
  <section class="ad-notes-section">
    <h2 class="ad-section-title">划线手记</h2>
    <div class="ad-highlights">
      <% highlights.forEach(function(h) { %>
      <div class="ad-hl-card">
        <p class="ad-hl-text">"<%= h.mark_text.replace(/"/g, '&quot;') %>"</p>
        <div class="ad-hl-meta">
          <span class="ad-hl-book">《<%= h.book_title %>》</span>
          <% if (h.chapter_title) { %><span class="ad-hl-chapter"><%= h.chapter_title %></span><% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Reviews from this author -->
  <% if (reviews.length > 0) { %>
  <section class="ad-notes-section">
    <h2 class="ad-section-title">读后想法</h2>
    <div class="ad-reviews">
      <% reviews.forEach(function(r) { %>
      <div class="ad-review-card">
        <p class="ad-review-text"><%= r.content.replace(/"/g, '&quot;') %></p>
        <div class="ad-review-meta">
          <span class="ad-review-book">《<%= r.book_title %>》</span>
          <% if (r.chapter_name) { %><span class="ad-review-chapter"><%= r.chapter_name %></span><% } %>
          <% if (r.star > 0) { %><span class="ad-review-star"><% for (var i=0; i<r.star; i++){%>★<%}%></span><% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

</div>
