<!-- ═══════════════════════════════════════════
   NOTEBOOKS — Literary Review
   ═══════════════════════════════════════════ -->

<div class="container-wide">
  <div class="catalog-header">
    <h1>笔记</h1>
    <div class="catalog-count"><%= totalNotebooks %> 册有笔记 · 共 <%= summary.totalNoteCount.toLocaleString() %> 条</div>
  </div>

  <% if (notebooks.length > 0) { %>
  <div class="notebook-list">
    <% notebooks.forEach(function(nb) { %>
    <a href="/bookshelf" class="notebook-item">
      <div class="notebook-cover">
        <% if (nb.cover) { %><img src="<%= nb.cover %>" alt="" loading="lazy" onerror="this.style.display='none';this.parentElement.innerHTML='📖'"><% } else { %>📖<% } %>
      </div>
      <div>
        <div class="notebook-title"><%= nb.title %></div>
        <div class="notebook-author"><%= nb.author || '佚名' %></div>
      </div>
      <div class="notebook-stats">
        <span><strong><%= nb.totalNotes %></strong> 笔记</span>
        <span><strong><%= nb.noteCount %></strong> 划线</span>
        <span><strong><%= nb.reviewCount %></strong> 想法</span>
        <span><strong><%= nb.bookmarkCount %></strong> 书签</span>
      </div>
    </a>
    <% }); %>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
  <div class="pagination">
    <% if (currentPage > 1) { %>
    <a href="/notebooks?page=<%= currentPage - 1 %>" class="page-btn">←</a>
    <% } %>
    <% for (var p = 1; p <= totalPages; p++) { %>
    <a href="/notebooks?page=<%= p %>" class="page-btn <%= p === currentPage ? 'active' : '' %>"><%= p %></a>
    <% } %>
    <% if (currentPage < totalPages) { %>
    <a href="/notebooks?page=<%= currentPage + 1 %>" class="page-btn">→</a>
    <% } %>
  </div>
  <% } %>

  <% } else { %>
  <div class="empty-state">
    <div class="empty-state-icon">—</div>
    <p class="empty-state-text">暂无笔记</p>
  </div>
  <% } %>
</div>
