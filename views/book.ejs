<!-- ═══════════════════════════════════════════
   BOOK DETAIL — Full-page book view
   ═══════════════════════════════════════════ -->

<div class="container-wide">
  <a href="/bookshelf" class="back-link">&larr; 返回书架</a>

  <div class="book-detail-top">
    <!-- Left column: Book info -->
    <div class="book-detail-left">
      <div class="book-detail-cover">
        <% if (book.cover) { %>
          <img src="<%= book.cover %>" alt="" onerror="this.style.display='none';this.parentElement.innerHTML='&#128218;'">
        <% } else { %>
          &#128218;
        <% } %>
      </div>

      <h1 class="book-detail-title"><%= book.title %></h1>
      <div class="book-detail-author"><%= book.author || '佚名' %></div>

      <div class="book-detail-meta">
        <% if (book.category) { %><span class="book-detail-tag"><%= book.category %></span><% } %>
        <% if (book.finished) { %><span class="book-detail-tag done">已读完</span><% } else { %><span class="book-detail-tag reading">在读</span><% } %>
      </div>

      <!-- Reading Stats — always show -->
      <div class="book-detail-stats">
        <div class="detail-stat">
          <span class="detail-stat-value"><%= helpers.formatTime(readTimeSec) %></span>
          <span class="detail-stat-label">阅读时长</span>
        </div>
        <% if (book.notebook) { %>
          <% if (book.notebook.noteCount > 0) { %>
          <div class="detail-stat">
            <span class="detail-stat-value"><%= book.notebook.noteCount %></span>
            <span class="detail-stat-label">划线</span>
          </div>
          <% } %>
          <% if (book.notebook.reviewCount > 0) { %>
          <div class="detail-stat">
            <span class="detail-stat-value"><%= book.notebook.reviewCount %></span>
            <span class="detail-stat-label">想法</span>
          </div>
          <% } %>
          <% if (book.notebook.bookmarkCount > 0) { %>
          <div class="detail-stat">
            <span class="detail-stat-value"><%= book.notebook.bookmarkCount %></span>
            <span class="detail-stat-label">书签</span>
          </div>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Right column: Monthly Reading Activity -->
    <div class="book-detail-right">
      <% if (monthlyBars && monthlyBars.length > 0) { %>
      <div class="book-monthly-activity">
        <div class="section-kicker">阅读足迹</div>
        <div class="monthly-bars">
          <% monthlyBars.forEach(function(m) { %>
          <div class="monthly-bar-row">
            <div class="monthly-bar-label"><%= m.label %></div>
            <div class="monthly-bar-track">
              <div class="monthly-bar-fill" style="width: <%= Math.round((m.estimatedSec / maxMonthlySec) * 100) %>%;">
                <span class="monthly-bar-time"><%= m.timeLabel %></span>
              </div>
            </div>
            <div class="monthly-bar-arrow">&#9662;</div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } else { %>
      <div class="book-monthly-activity book-monthly-empty">
        <div class="section-kicker">阅读足迹</div>
        <div class="monthly-empty-state">
          <% if (readTimeSec > 0) { %>
            <p class="monthly-empty-total">累计阅读 <%= helpers.formatTime(readTimeSec) %></p>
            <p class="monthly-empty-hint">按月分布数据将在下次同步后显示</p>
          <% } else { %>
            <p class="monthly-empty-hint">暂无月度阅读记录</p>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

    <!-- Highlights & Reviews — side by side -->
    <% if (highlights.length > 0 || reviews.length > 0) { %>
    <hr class="section-rule">
    <div class="detail-columns">
      <!-- Left: Highlights -->
      <div class="detail-col">
        <div class="section-head-row">
          <div class="section-kicker">划线摘录</div>
          <% if (highlights.length > 0) { %>
          <button class="shuffle-btn" data-section="highlights" data-book="<%= book.id %>" title="随机换一批">⟳</button>
          <% } %>
        </div>
        <% if (highlights.length > 0) { %>
        <div class="book-highlights" id="book-highlights">
          <% highlights.forEach(function(h) { %>
          <blockquote class="detail-highlight">
            <p><%= h.text %></p>
            <% if (h.chapter) { %><cite>— <%= h.chapter %></cite><% } %>
          </blockquote>
          <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state empty-state-col">
          <p class="empty-state-text">暂无摘录</p>
        </div>
        <% } %>
      </div>

      <!-- Right: Reviews -->
      <div class="detail-col">
        <div class="section-head-row">
          <div class="section-kicker">我的想法</div>
          <% if (reviews.length > 0) { %>
          <button class="shuffle-btn" data-section="reviews" data-book="<%= book.id %>" title="随机换一批">⟳</button>
          <% } %>
        </div>
        <% if (reviews.length > 0) { %>
        <div class="book-reviews" id="book-reviews">
          <% reviews.forEach(function(r) { %>
          <div class="detail-review">
            <p><%= r.content %></p>
            <% if (r.chapter) { %><cite>— <%= r.chapter %></cite><% } %>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state empty-state-col">
          <p class="empty-state-text">暂无想法</p>
        </div>
        <% } %>
      </div>
    </div>
    <% } else { %>
    <hr class="section-rule">
    <div class="empty-state">
      <p class="empty-state-text">暂无笔记摘录</p>
    </div>
    <% } %>
  </div>
</div>
