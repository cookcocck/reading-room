<!-- ═══════════════════════════════════════════
   ABOUT — Manifesto
   ═══════════════════════════════════════════ -->

<div class="container">
  <div class="about-section">
    <h1>关于</h1>

    <div class="about-lede">
      "阅读不是逃避，是在词语中寻找与自身深渊对应的回响。"
    </div>

    <!-- Stats Strip -->
    <div class="about-grid">
      <div class="stat-item">
        <div class="stat-number"><%= summary.totalBooks %></div>
        <div class="stat-label">册藏书</div>
      </div>
      <div class="stat-item">
        <div class="stat-number"><%= summary.finishedCount %></div>
        <div class="stat-label">已读完</div>
      </div>
      <div class="stat-item">
        <div class="stat-number"><%= Math.round((overall.totalReadTimeSec || 0) / 3600).toLocaleString() %><span class="unit">h</span></div>
        <div class="stat-label">累计阅读</div>
      </div>
      <div class="stat-item">
        <div class="stat-number"><%= (overall.readDays || 0).toLocaleString() %></div>
        <div class="stat-label">天在读书</div>
      </div>
    </div>

    <!-- Prose -->
    <div class="about-prose">
      <p>
        <% if (overall.registTime) { %>
        注册于微信读书 <%= new Date(overall.registTime * 1000).getFullYear() %> 年。真正的严肃阅读始于 2024 年——
        <% } %>
        从陀思妥耶夫斯基开始，一上来就读最沉重的东西：《罪与罚》、《卡拉马佐夫兄弟》、《白痴》。像是在跑步的第一天就冲刺马拉松。
      </p>
      <p>
        然后慢慢铺开：叔本华的意志哲学、庄子的逍遥、屠格涅夫与托尔斯泰、马尔克斯与博尔赫斯、康德与休谟。
        不是在读一本书，而是在搭建一座属于自己的思想体系。
      </p>
      <p>
        阅读很慢，因为生活和工作占据了大半时间。但每本打开的书都在等着合适的时刻——书不会跑。
      </p>
    </div>

    <hr class="about-rule">

    <!-- Categories -->
    <div class="section-kicker">藏书门类</div>
    <div class="category-cloud">
      <% if (summary.categories) { %>
      <% summary.categories.slice(0, 15).forEach(function(c) { %>
      <a href="/bookshelf?category=<%= encodeURIComponent(c.name) %>" class="category-tag"><%= c.name %></a>
      <% }); %>
      <% } %>
    </div>

    <% if (summary.archives && summary.archives.length > 0) { %>
    <hr class="about-rule">
    <div class="section-kicker">书单合集</div>
    <div class="archive-grid">
      <% summary.archives.forEach(function(arc) { %>
      <div class="archive-item">
        <div class="archive-name"><%= arc.name %></div>
        <div class="archive-count"><%= arc.count %> 册</div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <hr class="about-rule">

    <!-- Technical Note -->
    <div class="about-prose" style="font-size: var(--text-subhead); color: var(--ink-muted);">
      <p>
        数据来自 <a href="https://weread.qq.com" target="_blank" rel="noopener">微信读书</a>，
        通过官方 API 获取。书架与笔记为实时数据，统计为周期汇总。
      </p>
      <p>
        构建于 2026 · Node.js + Express + EJS · 
        <a href="https://github.com/hsueh-pei/reading-room" target="_blank" rel="noopener">GitHub</a>
      </p>
    </div>
  </div>
</div>
