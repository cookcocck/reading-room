<div class="ad-page">

  <!-- Breadcrumb -->
  <nav class="ad-breadcrumb">
    <a href="/authors" class="ad-breadcrumb-link">作者图谱</a>
    <span class="ad-breadcrumb-sep">/</span>
    <span class="ad-breadcrumb-current"><%= author.author %></span>
  </nav>

  <!-- Hero -->
  <header class="ad-hero">
    <h1 class="ad-hero-name"><%= author.author %></h1>
    <p class="ad-hero-byline">
      <% if (totalBooks > 0) { %><span><%= totalBooks %> 部作品</span><% } %>
      <% if (totalReadTime > 0) { %><span class="ad-hero-dot">·</span><span>累计阅读 <%= helpers.formatTime(totalReadTime) %></span><% } %>
      <% if (totalFinished > 0) { %><span class="ad-hero-dot">·</span><span>读完 <%= totalFinished %> 部</span><% } %>
      <% if (totalHighlights > 0) { %><span class="ad-hero-dot">·</span><span><%= totalHighlights %> 条摘录</span><% } %>
    </p>
  </header>

  <!-- Stats Row -->
  <div class="ad-stats-row">
    <div class="ad-stat-card">
      <div class="ad-stat-value"><%= totalBooks %></div>
      <div class="ad-stat-label">收录作品</div>
    </div>
    <div class="ad-stat-card">
      <div class="ad-stat-value"><%= totalFinished %><span class="ad-stat-unit">/ <%= totalBooks %></span></div>
      <div class="ad-stat-label">已读完</div>
      <% if (totalBooks > 0) { %>
      <div class="ad-stat-bar"><div class="ad-stat-bar-fill" style="width:<%= finishedPct %>%"></div></div>
      <% } %>
    </div>
    <div class="ad-stat-card">
      <div class="ad-stat-value"><%= helpers.formatTime(totalReadTime) %></div>
      <div class="ad-stat-label">累计阅读</div>
    </div>
    <div class="ad-stat-card">
      <div class="ad-stat-value"><%= totalHighlights %></div>
      <div class="ad-stat-label">精彩摘录</div>
    </div>
  </div>

  <!-- Category Tags + Reading Span -->
  <div class="ad-meta-row">
    <% if (categories && categories.length > 0) { %>
    <div class="ad-tags">
      <% categories.forEach(function(cat) { %>
      <span class="ad-tag"><%= cat.name %><span class="ad-tag-count"><%= cat.count %></span></span>
      <% }); %>
    </div>
    <% } %>
    <% if (firstRead) { %>
    <div class="ad-span">
      <span class="ad-span-label">阅读跨度</span>
      <span class="ad-span-date"><%= helpers.formatTimestamp(firstRead) %></span>
      <span class="ad-span-arrow">→</span>
      <span class="ad-span-date"><%= helpers.formatTimestamp(lastRead) %></span>
    </div>
    <% } %>
  </div>

  <!-- Books Section -->
  <section class="ad-section">
    <div class="ad-section-head">
      <h2 class="ad-section-title">作品</h2>
      <span class="ad-section-count"><%= totalBooks %> 本 · 按阅读时长排序</span>
    </div>
    <div class="ad-book-list">
      <% books.forEach(function(book) { %>
      <a href="/book/<%= book.id %>" class="ad-book">
        <div class="ad-book-cover">
          <% if (book.cover) { %>
          <img src="<%= book.cover %>" alt="<%= book.title %>" loading="lazy" />
          <% } else { %>
          <div class="ad-book-cover-empty"><%= (book.title || '?').charAt(0) %></div>
          <% } %>
        </div>
        <div class="ad-book-info">
          <div class="ad-book-head">
            <h3 class="ad-book-title"><%= book.title %></h3>
            <% if (book.finished) { %>
            <span class="ad-book-badge ad-book-badge--done">已读</span>
            <% } else if (book.read_time > 0) { %>
            <span class="ad-book-badge ad-book-badge--reading">在读</span>
            <% } else { %>
            <span class="ad-book-badge ad-book-badge--wish">想读</span>
            <% } %>
          </div>
          <div class="ad-book-details">
            <% if (book.category) { %><span class="ad-book-cat"><%= book.category %></span><% } %>
            <% if (book.read_time > 0) { %><span class="ad-book-time"><%= helpers.formatTime(book.read_time) %></span><% } %>
            <% if (book.progress > 0) { %><span class="ad-book-progress-pct"><%= book.progress %>%</span><% } %>
          </div>
          <% if (maxReadTime > 0 && book.read_time > 0) { %>
          <div class="ad-book-progress">
            <div class="ad-book-progress-fill" style="width: <%= Math.max((book.read_time || 0) / maxReadTime * 100, 1) %>%"></div>
          </div>
          <% } %>
        </div>
      </a>
      <% }); %>
    </div>
  </section>

  <!-- Highlights -->
  <section class="ad-section">
    <div class="ad-section-head">
      <h2 class="ad-section-title">精彩摘录</h2>
      <span class="ad-section-count"><%= totalHighlights %> 条</span>
    </div>
    <% if (highlights && highlights.length > 0) { %>
    <div class="ad-quotes">
      <% highlights.forEach(function(h) { %>
      <blockquote class="ad-quote">
        <p class="ad-quote-text"><%= h.mark_text %></p>
        <cite class="ad-quote-cite">
          《<%= h.book_title %>》
          <% if (h.chapter_title) { %><span class="ad-quote-chapter"><%= h.chapter_title %></span><% } %>
        </cite>
      </blockquote>
      <% }); %>
    </div>
    <% } else { %>
    <div class="ad-empty">
      <div class="ad-empty-text">暂无划线摘录</div>
      <div class="ad-empty-sub">阅读时划下喜欢的句子，它们会出现在这里</div>
    </div>
    <% } %>
  </section>

  <!-- Reviews -->
  <section class="ad-section">
    <div class="ad-section-head">
      <h2 class="ad-section-title">我的想法</h2>
      <span class="ad-section-count"><%= totalReviews %> 条</span>
    </div>
    <% if (reviews && reviews.length > 0) { %>
    <div class="ad-reviews-grid">
      <% reviews.forEach(function(r) { %>
      <article class="ad-review">
        <p class="ad-review-text"><%= r.content %></p>
        <footer class="ad-review-footer">
          <span class="ad-review-book">《<%= r.book_title %>》</span>
          <% if (r.star > 0) { %>
          <span class="ad-review-stars"><% for (var i=0; i<r.star; i++){%>★<%}%></span>
          <% } %>
        </footer>
      </article>
      <% }); %>
    </div>
    <% } else { %>
    <div class="ad-empty">
      <div class="ad-empty-text">暂无书评想法</div>
      <div class="ad-empty-sub">记录阅读时的感悟，它们会出现在这里</div>
    </div>
    <% } %>
  </section>

</div>
