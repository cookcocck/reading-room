<!-- ═══════════════════════════════════════════
   AUTHORS — Stardew Valley NPC Compendium
   ═══════════════════════════════════════════ -->

<div class="sd-npc-compendium">

  <!-- 标题栏 -->
  <header class="sd-npc-header">
    <div class="sd-npc-title">
      <span class="sd-npc-icon">👥</span>
      <span>NPC图鉴</span>
    </div>
    <div class="sd-npc-stats">
      <div class="sd-npc-stat">
        <span class="sd-npc-num"><%= totalAuthors %></span>
        <span class="sd-npc-label">已遇见</span>
      </div>
      <div class="sd-npc-stat">
        <span class="sd-npc-num"><%= totalBooks %></span>
        <span class="sd-npc-label">互动次数</span>
      </div>
      <div class="sd-npc-stat">
        <span class="sd-npc-num"><%= helpers.formatTime(totalTime) %></span>
        <span class="sd-npc-label">总交流</span>
      </div>
    </div>
  </header>

  <!-- 搜索筛选 -->
  <div class="sd-npc-toolbar">
    <input class="sd-npc-search" id="au-search" type="search" placeholder="🔍 搜索NPC…" autocomplete="off" />
    <select class="sd-npc-sort" id="au-sort">
      <option value="count">按好感度</option>
      <option value="time">按交流时长</option>
      <option value="name">按姓名</option>
    </select>
  </div>

  <!-- NPC网格 -->
  <div class="sd-npc-grid" id="au-grid">
    <% authors.forEach(function(author, idx) {
      var affinity = Math.min(100, author.books.length * 10);
      var npcRank = author.books.length >= 5 ? 'legendary' : (author.books.length >= 3 ? 'epic' : (author.books.length >= 2 ? 'rare' : 'common'));
    %>
    <div class="sd-npc-card rank-<%= npcRank %>" data-author="<%= author.author %>" data-count="<%= author.books.length %>" data-time="<%= author.totalReadTime %>"
         style="animation-delay: <%= Math.min(idx * 30, 600) %>ms">
      <!-- NPC头像区 -->
      <div class="sd-npc-avatar-area">
        <div class="sd-npc-avatar">
          <% var covers = author.books.filter(function(b){ return b.cover; }).slice(0, 1); %>
          <% if (covers.length > 0) { %>
          <img src="<%= covers[0].cover %>" alt="" class="sd-npc-avatar-img" loading="lazy">
          <% } else { %>
          <span class="sd-npc-avatar-fallback">👤</span>
          <% } %>
        </div>
        <div class="sd-npc-rank-badge"><%= npcRank === 'legendary' ? '★★★' : (npcRank === 'epic' ? '★★' : (npcRank === 'rare' ? '★' : '')) %></div>
      </div>

      <!-- NPC信息 -->
      <div class="sd-npc-info">
        <h2 class="sd-npc-name"><%= author.author %></h2>
        <div class="sd-npc-meta">
          <span>💝 <%= author.books.length %> 心</span>
          <% if (author.totalReadTime > 0) { %>
          <span>· ⏱ <%= helpers.formatTime(author.totalReadTime) %></span>
          <% } %>
          <% if (author.finishedCount > 0) { %>
          <span>· ✅ <%= author.finishedCount %> 任务</span>
          <% } %>
        </div>

        <!-- 好感度条 -->
        <div class="sd-npc-affinity">
          <div class="sd-affinity-bar">
            <div class="sd-affinity-fill" style="width: <%= affinity %>%"></div>
          </div>
          <span class="sd-affinity-text"><%= affinity %>%</span>
        </div>

        <!-- 作品列表 -->
        <ul class="sd-npc-works">
          <% author.books.slice(0, 3).forEach(function(b) { %>
          <li class="sd-npc-work"><a href="/book/<%= b.id %>"><%= b.title %></a></li>
          <% }); %>
          <% if (author.books.length > 3) { %>
          <li class="sd-npc-work-more">…还有 <%= author.books.length - 3 %> 个任务</li>
          <% } %>
        </ul>
      </div>
    </div>
    <% }); %>
  </div>

  <div class="sd-npc-empty" id="au-empty" style="display:none">
    <div class="sd-npc-empty-icon">🔍</div>
    <p>没有找到匹配的NPC</p>
  </div>

</div>

<script>
(function(){
  var search  = document.getElementById('au-search');
  var sortSel = document.getElementById('au-sort');
  var grid    = document.getElementById('au-grid');
  var emptyEl = document.getElementById('au-empty');
  var cards   = Array.from(grid.querySelectorAll('.sd-npc-card'));

  function filter() {
    var q = search.value.trim().toLowerCase();
    var sortKey = sortSel.value;
    var visible = cards.filter(function(c) {
      return !q || c.dataset.author.toLowerCase().includes(q);
    });
    cards.forEach(function(c){ c.style.display = 'none'; });
    visible.sort(function(a, b) {
      if (sortKey === 'time')  return parseInt(b.dataset.time)  - parseInt(a.dataset.time);
      if (sortKey === 'name')  return a.dataset.author.localeCompare(b.dataset.author, 'zh');
      return parseInt(b.dataset.count) - parseInt(a.dataset.count);
    });
    visible.forEach(function(c){ c.style.display = ''; grid.appendChild(c); });
    emptyEl.style.display = visible.length ? 'none' : '';
  }

  search.addEventListener('input', filter);
  sortSel.addEventListener('change', filter);
})();
</script>
