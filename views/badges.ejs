<!-- ═══════════════════════════════════════════
   BADGES — Ex Libris Seal Style (藏书票圆章)
   左圆章 + 右竖排字 · 细线印章 · 米纸波纹
   ═══════════════════════════════════════════ -->

<div class="bg-container">

  <!-- ═══ Hero：一枚大藏书票 ═══ -->
  <header class="bg-hero bg-hero-plate">
    <div class="bg-seal bg-seal-hero" aria-hidden="true">
      <div class="bg-seal-paper">
        <div class="bg-seal-ticks"></div>
        <div class="bg-seal-ring bg-seal-r1"></div>
        <div class="bg-seal-ring bg-seal-r2"></div>
        <div class="bg-seal-dots bg-seal-dots-t"></div>
        <svg class="bg-seal-nib" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="30" cy="30" r="26" stroke="currentColor" stroke-width="1" opacity="0.55"/>
          <circle cx="30" cy="30" r="22" stroke="currentColor" stroke-width="0.6" opacity="0.4"/>
          <path d="M30 8v44M8 30h44" stroke="currentColor" stroke-width="0.5" opacity="0.35"/>
          <circle cx="30" cy="30" r="3" stroke="currentColor" stroke-width="0.8" opacity="0.7"/>
          <path d="M30 14c3 7 10 11 10 18 0 6-4.5 11-10 14-5.5-3-10-8-10-14 0-7 7-11 10-18z" stroke="currentColor" stroke-width="1.2"/>
          <path d="M30 14c-1 6-4 8-5.5 12M30 14c1 6 4 8 5.5 12M30 46c-3-6-7-8-8.5-12M30 46c3-6 7-8 8.5-12" stroke="currentColor" stroke-width="0.6" opacity="0.6"/>
        </svg>
        <div class="bg-seal-dots bg-seal-dots-b"></div>
      </div>
    </div>
    <div class="bg-hero-vertical">
      <span class="bg-hero-vdot"></span>
      <span class="bg-hero-vtext">功勋录</span>
      <span class="bg-hero-vdot"></span>
      <span class="bg-hero-vsub"><%= earnedCount %> / <%= totalBadges %></span>
    </div>
  </header>

  <!-- ═══ 勋章网格：藏书票卡片 ═══ -->
  <div class="bg-grid">
    <% badges.forEach(function(badge, idx) { %>
    <div class="bg-plate <%= badge.earned ? 'earned' : 'locked' %> theme-<%= idx % 6 %>" onclick="showBadgeDetail(<%= idx %>)">
      <div class="bg-plate-inner">
        <!-- 左侧：圆章 -->
        <div class="bg-seal">
          <div class="bg-seal-paper">
            <div class="bg-seal-ticks"></div>
            <div class="bg-seal-ring bg-seal-r1"></div>
            <div class="bg-seal-ring bg-seal-r2"></div>
            <div class="bg-seal-dots bg-seal-dots-t"></div>
            <svg class="bg-seal-symbol" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <%- badge.svg %>
            </svg>
            <div class="bg-seal-dots bg-seal-dots-b"></div>
            <div class="bg-seal-no">No.<%= String(idx + 1).padStart(3, '0') %></div>
          </div>
        </div>
        <!-- 右侧：竖排文字 -->
        <div class="bg-plate-side">
          <div class="bg-plate-name"><%= badge.name %></div>
          <div class="bg-plate-target"><%= badge.target %><%= badge.unit || '' %></div>
          <% if (!badge.earned) { %>
          <div class="bg-plate-lock">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="11" width="18" height="11" rx="1"/><path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

</div>

<!-- ═══ 勋章详情弹窗 ═══ -->
<div class="bg-modal" id="badgeModal" onclick="if(event.target===this)closeBadgeDetail()">
  <div class="bg-modal-card">
    <button class="bg-modal-close" onclick="closeBadgeDetail()">✕</button>
    <div class="bg-seal bg-seal-modal">
      <div class="bg-seal-paper">
        <div class="bg-seal-ticks"></div>
        <div class="bg-seal-ring bg-seal-r1"></div>
        <div class="bg-seal-ring bg-seal-r2"></div>
        <div class="bg-seal-dots bg-seal-dots-t"></div>
        <svg class="bg-seal-symbol" id="modalSymbol" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"></svg>
        <div class="bg-seal-dots bg-seal-dots-b"></div>
        <div class="bg-seal-no" id="modalNumber"></div>
      </div>
    </div>
    <h2 class="bg-modal-title" id="modalTitle"></h2>
    <p class="modal-desc" id="modalDesc"></p>
    <div class="bg-modal-progress">
      <div class="bg-modal-progress-track">
        <div class="bg-modal-progress-fill" id="modalProgressFill"></div>
      </div>
      <div class="bg-modal-progress-text" id="modalProgressText"></div>
    </div>
    <div class="bg-modal-status" id="modalStatus"></div>
  </div>
</div>

<script>
const badgeData = <%- JSON.stringify(badges) %>;
function showBadgeDetail(idx) {
  const b = badgeData[idx];
  document.getElementById('modalSymbol').innerHTML = b.svg || '';
  document.getElementById('modalNumber').textContent = 'No.' + String(idx + 1).padStart(3, '0');
  document.getElementById('modalTitle').textContent = b.name;
  document.getElementById('modalDesc').textContent = b.desc;
  const pct = Math.min(100, Math.round(b.progress / b.target * 100));
  document.getElementById('modalProgressFill').style.width = pct + '%';
  document.getElementById('modalProgressText').textContent = b.progress + (b.unit || '') + ' / ' + b.target + (b.unit || '');
  document.getElementById('modalStatus').textContent = b.earned ? '✓ 已获得' : '未获得';
  document.getElementById('modalStatus').className = 'bg-modal-status ' + (b.earned ? 'earned' : 'locked');
  const seal = document.querySelector('#badgeModal .bg-seal-modal');
  seal.className = 'bg-seal bg-seal-modal theme-' + (idx % 6) + ' ' + (b.earned ? 'earned' : 'locked');
  document.getElementById('badgeModal').style.display = 'flex';
}
function closeBadgeDetail() { document.getElementById('badgeModal').style.display = 'none'; }
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeBadgeDetail(); });
</script>
